# backend/.dockerignore
# Docker 构建 context = ./backend 目录（docker-compose 指定）
# 目的：不把本地数据、虚拟环境、缓存等塞入镜像

# 本地数据库（55 MB+，运行时通过 volume 或全新创建）
*.db
*.sqlite3
*.db-journal

# 环境文件（通过 --env-file 或 docker-compose env_file 注入）
.env
.env.local
.env.production

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 测试 & 开发
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
requirements-dev.txt

# 日志 / 运行时产物
logs/
uploads/
output/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
