# ============================================================
# 智研星枢 后端环境变量
# 对齐 app/config.py Settings（env_file = ".env"）
# ⚠️ 务必把 QWEN_API_KEY 换成阿里云百炼申请的真实密钥
# ============================================================

# ---- 应用基础 ----
APP_NAME=智研星枢
APP_VERSION=3.0.0
DEBUG=True
SECRET_KEY=please-change-this-to-a-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- 数据库（绝对路径，避免 CWD 歧义）----
DATABASE_URL=sqlite+aiosqlite:///D:/AI_Scientist/AI_Scientist/backend/zhixing.db

# ---- 通义千问 Qwen ----
QWEN_API_KEY=sk-ws-H.EEPXYLE.dyIc.MEQCIGV7kRHRXM8cctXVpl-0LSF_z6CusL4J3c4ijs9tbxkdAiBCmJ2R5EfwgDPTIINkiZLEUqzjDEJ_7YEKCQsP76Zkdg
QWEN_MODEL_NAME=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_MAX_TOKENS=8192
QWEN_TEMPERATURE=0.7

# ---- 安全/限流 ----
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=20
ALLOWED_ORIGINS=["http://localhost:5173"]

# ---- 可观测性 ----
TRACE_RETENTION_DAYS=30
COST_ALERT_THRESHOLD_YUAN=100.0
LOG_LEVEL=DEBUG

# ---- 管理员初始账号 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_EMAIL=admin@zhixing.ai

# ---- 目录 ----
UPLOAD_DIR=uploads
LOG_DIR=logs