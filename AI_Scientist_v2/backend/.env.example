# ============================================================
# 智研星枢 后端环境变量样板
# 用法：copy .env.example .env  然后按需填写
# 对齐 app/config.py 中的 Settings(env_file=".env")
# ⚠️ QWEN_API_KEY 必须换成阿里云百炼申请的真实密钥
# ⚠️ SECRET_KEY 必须换成随机字符串（如 python -c "import secrets;print(secrets.token_hex(32))"）
# ⚠️ ADMIN_PASSWORD 请在正式部署前更换为强口令
# ============================================================

# ---- 应用基础 ----
APP_NAME=智研星枢
APP_VERSION=3.0.0
DEBUG=True
# 生产环境务必替换为随机字符串（推荐: openssl rand -hex 32）
SECRET_KEY=please-change-this-to-a-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- 数据库 ----
# 开发（SQLite）：绝对/相对路径均可，注意 Windows 反斜杠转义
DATABASE_URL=sqlite+aiosqlite:///./zhixing.db
# 生产（PostgreSQL）示例，需时装 asyncpg：
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/zhixing

# ---- 通义千问 Qwen（阿里云百炼 DashScope）----
QWEN_API_KEY=sk-ws-H.EEPXYLE.dyIc.MEQCIGV7kRHRXM8cctXVpl-0LSF_z6CusL4J3c4ijs9tbxkdAiBCmJ2R5EfwgDPTIINkiZLEUqzjDEJ_7YEKCQsP76Zkdg

QWEN_MODEL_NAME=qwen-max
QWEN_VISION_MODEL=qwen-vl-max
QWEN_MAX_TOKENS=8192
QWEN_TEMPERATURE=0.7
# 首选模型限流/未开通时的回退顺序（逗号分隔）
QWEN_FALLBACK_MODELS=qwen-plus,qwen-max,qwen-max-longcontext
# 通义千问兼容端点（OpenAI Chat Completions），一般无需改
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# ---- 多模型供应商（均为 OpenAI 兼容 /chat/completions 接口；密钥留空则该供应商不出现在下拉/生成中）----
# DeepSeek（platform.deepseek.com 申请）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner
# Moonshot Kimi（platform.moonshot.cn 申请）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1/chat/completions
MOONSHOT_MODELS=moonshot-v1-8k,moonshot-v1-32k,moonshot-v1-128k
# 智谱 GLM（open.bigmodel.cn 申请）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODELS=glm-4-flash,glm-4-air,glm-4-plus
# 自定义通用 OpenAI 兼容端点（Base URL + Key + 逗号分隔模型名，三者齐全才生效）
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODELS=

# ---- 安全 / 限流 ----
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=20
# JSON 数组字符串，或逗号分隔
ALLOWED_ORIGINS=["http://localhost:5173"]

# ---- 可观测性 ----
TRACE_RETENTION_DAYS=30
COST_ALERT_THRESHOLD_YUAN=100.0
LOG_LEVEL=INFO

# ---- 管理员初始账号（init_db 会创建）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_EMAIL=admin@zhixing.ai

# ---- 目录 ----
UPLOAD_DIR=uploads
LOG_DIR=logs
