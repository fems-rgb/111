import sys, os, asyncio
sys.path.insert(0, r'D:\AI_Scientist\AI_Scientist\backend')
os.chdir(r'D:\AI_Scientist\AI_Scientist\backend')

from dotenv import load_dotenv
load_dotenv()

from app.agents.orchestrator import orchestrator
from app.database.models import AgentTask, ProjectStatus

async def resume_pipeline():
    project_id = 1
    user_id = 1
    
    orchestrator._running_projects[project_id] = True
    print(f'Set _running_projects[{project_id}] = True')
    
    from app.database.session import AsyncSessionLocal
    from sqlalchemy import select
    
    async with AsyncSessionLocal() as db:
        result = await db.execute(
            select(AgentTask).where(AgentTask.project_id == project_id).order_by(AgentTask.step_order)
        )
        tasks = result.scalars().all()
        model = None
        for t in tasks:
            if t.model_used:
                model = t.model_used
                break
        if not model:
            model = "qwen-plus"
        
        print(f'Total tasks: {len(tasks)}')
        for t in tasks:
            print(f'   Task#{t.id} | {t.agent_name:20s} | step={t.step_order} | status={t.status} | model={t.model_used}')
        print(f'\nResuming _execute_pipeline with model={model}')
    
    await orchestrator._execute_pipeline(project_id, user_id, model)
    print('\nPipeline execution finished')

asyncio.run(resume_pipeline())
