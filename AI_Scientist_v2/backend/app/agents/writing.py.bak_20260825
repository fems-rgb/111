"""智研星枢 - 学术写作Agent"""
from app.agents.base import BaseAgent


class WritingAgent(BaseAgent):
    name = "writing"
    display_name = "✍️ 学术写作Agent"
    description = "将研究成果整合为规范学术论文"
    requires_review = True
    system_prompt = """你是CSSCI/SSCI期刊论文写作专家。基于前序研究撰写完整学术论文，必须满足：

【结构要求】
1. 标题（20字以内，准确反映核心变量与关系）
2. 摘要（300字，含研究目的、方法、核心发现、理论贡献）
3. 关键词（3-5个，中英文对照）
4. 引言（1000-1200字）：问题提出→文献缺口→本研究切入点→边际贡献（≥3点）
5. 文献综述与研究假设（1800-2200字）：按主题聚类评述→指出矛盾/空白→推导假设（每个假设需理论支撑+逻辑链）
6. 研究设计（1000-1200字）：数据来源与样本筛选→变量操作化定义表→模型设定与识别策略→内生性处理方案
7. 实证分析（1800-2200字）：描述性统计→主回归结果解读（系数方向、显著性、经济意义）→稳健性检验（≥3种，说明为何有效）→异质性分析
8. 结论与讨论（1000-1200字）：核心发现总结→理论对话（与既有文献比较）→政策/实践启示→局限性与未来方向

【质量红线】
- 总字数严格控制在7000-9000字，各章节不得低于上述下限
- 禁止空泛表述，每段必须有数据/文献/理论支撑
- 所有引用必须符合GB/T 7714-2015格式，正文标注[序号]
- 实证结果需报告具体数值（系数、标准误、p值、R²等）
- 讨论部分必须回应引言提出的研究问题，形成闭环

若前序成果信息不足，明确标注"[待补充: XXX]"而非编造内容。"""

    def build_prompt(self, research_question: str, context: str, **kwargs) -> str:
        # 扩大上下文窗口，避免关键信息被截断
        max_context = 12000
        truncated = context[:max_context]
        note = "" if len(context) <= max_context else "\n\n⚠️ 注意：前序成果已截断，优先使用已有信息，缺失处标注[待补充]"
        
        return f"""请基于以下材料撰写完整学术论文，严格遵守system_prompt中的结构与质量要求。

## 研究问题
{research_question}

## 前序研究成果
{truncated}{note}

## 输出要求
- 直接输出论文全文，无需额外说明
- 字数目标：7000-9000字
- 格式：Markdown，章节标题用##，子标题用###"""
