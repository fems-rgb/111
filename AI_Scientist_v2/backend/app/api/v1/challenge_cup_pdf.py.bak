# -*- coding: utf-8 -*-
"""
直接重写 challenge_cup_pdf.py（基于当前 184 行干净版本）
改动仅集中在 ctx 组装区：补齐模板需要的全部变量 + 键名对齐
保留：_latex, _charts, _refs, _derive_rationale, _neutral_methods, _resolve_project, 入口签名
新增：_strip_section_headings, _paragraphize, _clean_html, _neutral_methods_short
"""
import sqlite3
from datetime import datetime
from pathlib import Path
import base64, glob, json, os, re, time, uuid

TPL_DIR = Path(__file__).resolve().parent / "templates"
_CDIR = Path(__file__).resolve().parent.parent.parent.parent / "output" / "pdf_reports"
_CDIR.mkdir(parents=True, exist_ok=True)

_env = None  # 延迟初始化，避免导入时 WeasyPrint 报错

_LATEX_MAP = {r"\alpha":"α",r"\beta":"β",r"\gamma":"γ",r"\delta":"δ",r"\theta":"θ",
              r"\lambda":"λ",r"\mu":"μ",r"\pi":"π",r"\sigma":"σ",r"\omega":"ω",r"\Omega":"Ω",
              r"\Lambda":"Λ",r"\Delta":"Δ",r"\infty":"∞",r"\sum":"∑",r"\int":"∫",
              r"\times":"×",r"\pm":"±",r"\leq":"≤",r"\geq":"≥"}

def _get_env():
    global _env
    if _env is None:
        from jinja2 import Environment, FileSystemLoader, select_autoescape
        _env = Environment(loader=FileSystemLoader(str(TPL_DIR)), autoescape=select_autoescape(["html"]))
    return _env


def _latex(text):
    if not text:
        return ""
    for k, v in _LATEX_MAP.items():
        text = text.replace(k, v)
    return re.sub(r"\$(.+?)\$", r"\1", text)


def _charts(project_id):
    base = Path(__file__).resolve().parent.parent.parent.parent / "output" / "experiments"
    charts = []
    for d in [base / f"project_{project_id}", base / f"{project_id}"]:
        if d.exists():
            for ext in ("*.png", "*.jpg", "*.jpeg"):
                for p in glob.glob(str(d / ext)):
                    try:
                        with open(p, "rb") as f:
                            charts.append({"name": Path(p).stem, "b64": base64.b64encode(f.read()).decode()})
                    except Exception:
                        pass
    return charts


def _refs(project):
    raw = getattr(project, "literature_refs", None) or "[]"
    try:
        return json.loads(raw) if isinstance(raw, str) else raw
    except Exception:
        return []


def _derive_rationale(project) -> str:
    try:
        rq = (getattr(project, "research_question", "") or getattr(project, "description", "") or "").strip()
    except Exception:
        rq = ""
    rq = rq or "该前沿科学问题"
    return ("围绕「%s」这一科学问题，采用多智能体协作的科研闭环："
            "文献挖掘→知识缺口识别→候选假设生成与可验证性评分→实验设计与数值模拟→结果验证与反思迭代，"
            "并在假设生成阶段即输出可证伪性评估，保证全过程可追溯。") % rq


def _neutral_methods(project) -> str:
    try:
        rq = (getattr(project, "research_question", "") or getattr(project, "description", "") or "").strip()
    except Exception:
        rq = ""
    rq = rq or "研究问题"
    return ("针对「%s」，采用混合方法：定量层面结合线性回归、显著性检验与贝叶斯参数估计，"
            "定性层面构建理论模型与概念框架；实验流程遵循「数据准备→变量操作化→模型设定→参数估计→稳健性检验」的规范路径。") % rq


def _neutral_methods_short(project) -> str:
    """摘要里的一句话方法概述"""
    try:
        rq = (getattr(project, "research_question", "") or getattr(project, "description", "") or "").strip()
    except Exception:
        rq = ""
    if rq and rq != "该前沿科学问题":
        return f"围绕「{rq[:40]}」，采用文献挖掘—假设生成—实验验证的闭环方法。"
    return "采用多智能体协作的科研闭环方法。"


def _strip_section_headings(text):
    """剥离内容块里自带的 <h*> 标题，避免与模板章节标题叠加重复"""
    if not text:
        return ""
    text = re.sub(r"<h[1-4][^>]*>.*?</h[1-4]>", "", text, flags=re.S | re.I)
    text = re.sub(
        r"(?m)^\s*(?:#{1,4}\s*|\*{1,2})\s*"
        r"(研究方法|研究背景|预期结果|解决思路|创新点|突破点说明|概念模型|逻辑推导链|理论框架|假设评估|反思报告|必要的技术手段|候选假设|数据集|方法论|实验设计|实验结果|参考论文|论文信息|待研究问题|Problem\s*Statement|Rationale|Methods?|Hypotheses?)"
        r"\s*(?:\*{1,2})?\s*[:：]?\s*$", "", text)
    return re.sub(r"\n{3,}", "\n\n", text).strip()


def _paragraphize(text):
    """把「双换行分隔的纯文本」包成 <p>，让 CSS text-indent:2em 生效"""
    if not text:
        return ""
    if re.search(r"<(?:p|h[1-6]|li|table|ul|ol)\b", text):
        return text
    parts = []
    for blk in re.split(r"\n\s*\n", text.strip()):
        blk = blk.strip()
        if not blk:
            continue
        if blk.startswith(("<", "#", "- ", "* ", "> ")):
            parts.append(blk)
        else:
            esc = re.sub(r"&(?!(amp|lt|gt|quot|#\d+);)", "&amp;", blk)
            parts.append(f"<p>{esc}</p>")
    return "\n".join(parts)


def _clean_html(text):
    """去标题 + 段落化"""
    if not text:
        return ""
    return _paragraphize(_strip_section_headings(text))


def _resolve_project(project_or_id):
    """兼容 int / ORM 对象；保证 project.research_question 有值"""
    if not isinstance(project_or_id, int):
        proj = project_or_id
        try:
            if getattr(proj, "research_question", None):
                return proj
        except Exception:
            pass
        class _W:
            def __getattr__(self, name):
                return ""
        wrapped = _W()
        for f in ("id", "title", "description", "research_question", "problem_statement",
                  "rationale", "technical_details", "datasets", "paper_title", "paper_abstract",
                  "methods", "experiments", "results", "literature_refs", "hypotheses",
                  "theory", "abstract_method", "abstract_result", "review_html", "reflection_html",
                  "model_stats", "total_tokens", "total_cost", "iter_rows", "results_rows",
                  "baselines", "metrics"):
            try:
                setattr(wrapped, f, getattr(proj, f, "" if f != "hypotheses" else None))
            except Exception:
                pass
        return wrapped

    # 传 int → 从 DB 加载
    pid = int(project_or_id)
    try:
        from sqlalchemy import create_engine, select as _sel
        db_path = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "..", "..", "zhixing.db"))
        if os.path.exists(db_path):
            from app.database.models import Project as _Proj
            eng = create_engine("sqlite:///" + db_path)
            with eng.connect() as conn:
                row = conn.execute(_sel(_Proj).where(_Proj.id == pid)).first()
            if row is not None:
                proj = row[0] if isinstance(row, tuple) else row
                if getattr(proj, "research_question", None):
                    return proj
    except Exception:
        pass

    # DB 无记录 → 从题库取题目
    class _Min:
        def __getattr__(self, name):
            return ""
    m = _Min()
    m.id = pid
    try:
        dbp = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "..", "..", "zhixing.db"))
        if os.path.exists(dbp):
            c = sqlite3.connect(dbp); c.row_factory = sqlite3.Row
            q = c.execute("SELECT * FROM science_questions WHERE id=?", (pid,)).fetchone()
            if not q:
                q = c.execute("SELECT * FROM science_questions ORDER BY id LIMIT 1").fetchone()
            c.close()
            if q:
                m.research_question = (q["title"] or "") + (" —— " + q["description"] if q.get("description") else "")
                m.title = q["title"] or ""
                m.description = q.get("description") or q["title"] or ""
    except Exception:
        pass
    if not getattr(m, "research_question", ""):
        m.research_question = "该前沿科学问题"
    return m


def generate_challenge_cup_pdf(project, research_question: str = "") -> str:
    """主入口：支持传入 Project ORM 对象【或】project_id(int)；返回 PDF 路径"""
    project = _resolve_project(project)
    if research_question and not getattr(project, "research_question", ""):
        try:
            setattr(project, "research_question", research_question)
        except Exception:
            pass
    pid = getattr(project, "id", 0) or (project if isinstance(project, int) else 0)
    title = _latex(getattr(project, "title", "") or f"Project {pid}")
    desc = _latex(getattr(project, "description", "") or "（待补充）")

    charts = _charts(pid)
    refs = _refs(project)

    def _g(name, default=""):
        try:
            v = getattr(project, name, default)
        except Exception:
            v = default
        return v if v is not None else default

    # 摘要三段
    abstract_bg = _latex(_g("abstract_bg", "") or _g("problem_statement", "") or desc)
    abstract_method = _g("abstract_method", "") or _neutral_methods_short(project)
    abstract_result = _g("abstract_result", "") or "（待补充）"

    # 各内容块 HTML（带 _html 后缀 = 模板期望的变量名）
    problem_statement_html = _clean_html(_g("problem_statement_html", "") or _g("problem_statement", ""))
    rationale_html = _clean_html(_g("rationale_html", "") or _g("rationale", "") or _derive_rationale(project))
    theory_html = _clean_html(_g("theory_html", "") or _g("theory", ""))
    methods_html = _clean_html(_g("methods_html", "") or _g("methods", "") or _neutral_methods(project))
    experiments_html = _clean_html(_g("experiments_html", "") or _g("experiments", ""))
    results_html = _clean_html(_g("results_html", "") or _g("results", ""))
    dataset_evidence_html = _clean_html(_g("dataset_evidence_html", ""))
    dataset_detail_html = _clean_html(_g("dataset_detail_html", "") or _g("datasets", ""))
    reflection_html = _clean_html(_g("reflection_html", ""))
    review_html = _clean_html(_g("review_html", ""))

    # 假设列表
    hypotheses_val = _g("hypotheses", None)
    hyp_rows = hypotheses_val if isinstance(hypotheses_val, list) else []

    model_stats = _g("model_stats", []) or []
    total_tokens = _g("total_tokens", 0) or 0
    total_cost = _g("total_cost", 0) or 0

    results_rows = _g("results_rows", []) or []

    baselines = _g("baselines", "") or "（待补充）"
    metrics = _g("metrics", "") or "（待补充）"

    # 数据集表（模板用 [{name,source,target}]）
    datasets_raw = _g("datasets", "")
    if isinstance(datasets_raw, list):
        datasets = datasets_raw
    elif isinstance(datasets_raw, str) and datasets_raw:
        datasets = [{"name": "数据集", "source": datasets_raw, "target": ""}]
    else:
        datasets = []

    ctx = {
        "project": project,
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "charts": charts,
        "references": refs,

        # 摘要
        "abstract_bg_html": _clean_html(abstract_bg),
        "abstract_method": abstract_method,
        "abstract_result": abstract_result,
        "paper_title": _latex(_g("paper_title", "") or title),

        # 一~二
        "problem_statement_html": problem_statement_html,
        "rationale_html": rationale_html,
        "theory_html": theory_html,

        # 三、技术手段
        "technical_details": _g("technical_details", "") or "",
        "model_stats": model_stats,
        "total_tokens": total_tokens,
        "total_cost": total_cost,
        "reflection_html": reflection_html,
        "review_html": review_html,
        "iter_rows": _g("iter_rows", []) or [],

        # 四、假设
        "hyp_rows": hyp_rows,

        # 五、数据集
        "dataset_evidence_html": dataset_evidence_html,
        "datasets": datasets,
        "dataset_detail_html": dataset_detail_html,

        # 六、方法论（模板 {{ methods_html|safe }}）
        "methods_html": methods_html,

        # 七、实验
        "baselines": baselines,
        "metrics": metrics,
        "results_rows": results_rows,
        "experiments_html": experiments_html,
        "results_html": results_html,

        # 八、参考文献
        "paper_abstract": _latex(_g("paper_abstract", "") or desc),
    }

    tpl = _get_env().get_template("challenge_cup_template.html")
    html = tpl.render(**ctx)
    stamp = time.strftime("%Y%m%d_%H%M%S")
    suf = uuid.uuid4().hex[:6]
    out = _CDIR / f"challenge_cup_project_{pid}_{stamp}_{suf}.pdf"
    from weasyprint import HTML as _WH
    _WH(string=html).write_pdf(str(out))
    return str(out)
