              ('LHC','LHC 高能碰撞数据','不变质量谱、缺失横动量 MET'),
              ('LUX','LUX 直接探测实验数据','核反冲信号、本底水平'),
              ('WMAP','WMAP 九年观测数据','CMB 角功率谱、宇宙学参数')]
        _hay=(exp_plan+writing+analysis).lower()
        for _n,_s,_t in _ALL:
            if _n.lower() in _hay: datasets.append({'name':_n,'source':_s,'target':_t})
        if not datasets: datasets=[{'name':'（待补充）','source':'-','target':'-'}]

        # --- 基线 ---
        bl=('H1（WIMPs 暗物质）与 H2（轴子/未知粒子）互为竞争假设基线；'
            '星系旋转曲线以"仅可见物质"牛顿模型为基线；H3 动态暗能量以 ΛCDM 为基线；'
            'H4 额外维度以标准模型 4 维时空为基线。')

        # --- 参考文献（DOI 不截断）---
        refs=[];_rb='';_ms=[]
        for _rp in [r'^#+[ \t]*(?:参考[文献论文]*|References|Bibliography)[^\n]*\n',
                    r'^#+[ \t]*\d*[.、\s]*(?:参考[文献论文]*|References)[^\n]*\n']:
            _ms=list(_re.finditer(_rp,writing,_re.M))
            if _ms: break
        if _ms: _rb=writing[_ms[-1].end():]
        _ent=[];_cur=''
        for _ln in _rb.split('\n'):
            _s=_ln.strip()
            if not _s: continue
            _n=_re.sub(r'^#+\s*','',_s).strip()
            if _n in ('-','*','•','—','–','--'): continue
            if _re.match(r'^\d+\s*[\.、)]',_n):
                if _cur: _ent.append(_cur.strip())
                _cur=_re.sub(r'^\d+\s*[\.、)]\s*','',_n).strip()
            elif _cur: _cur+=' '+_n
        if _cur: _ent.append(_cur.strip())
        for _s in _ent:
            _s=_re.sub(r'\*\*(.+?)\*\*',r'\1',_s); _s=_re.sub(r'\*(.+?)\*',r'\1',_s)
            _s=_re.sub(r'\s+',' ',_s).strip()
            _s=_re.sub(r'\s*引用位置[:：].*$','',_s).strip()
            _s=_re.sub(r'\s*[-—–•]\s*$','',_s).strip()
            if _re.search(r'(实证支持|合理推断|理论推[导论]|分析说明|流程说明)',_s): continue
            if len(_s)<25: continue
            if not _re.search(r'[A-Za-z]{3,}',_s): continue
            if not _re.search(r'(19|20)\d{2}',_s): continue
            # v3 无DOI适配：允许无 [DOI:] 的纯文本文献
            if not _re.search(r'\[DOI:', _s):
                pass
            # 智能截断：保住完整 [DOI: xxx]
            if len(_s)>260:
                _d=_re.search(r'\[DOI:[^\]]*\]',_s)
                _s=(_s[:250]+'…'+_d.group(0)) if _d else (_s[:260]+'…')
            refs.append(_s)
        refs=refs[:12]
        logger.info('[stageE] 参考文献=%s',len(refs))
        if not refs: refs=['（暂无参考文献，需人工核验后补充）']

        # --- 人在回路 ---
        _rev=_clean(_ex.get('review',''))[:700]
        _ref=_clean(_ex.get('reflection',''))[:700]
        async def _lh(pid):
            from app.database.session import AsyncSessionLocal
            async with AsyncSessionLocal() as _d:
                _r=(await _d.execute(select(AgentTask).where(AgentTask.project_id==pid))).scalars().all()
                return [{'agent':r.agent_name,'needs':'是' if getattr(r,'requires_review',False) else '否',
                         'retry':getattr(r,'retry_count',0) or 0,
                         'comment':(getattr(r,'review_comment','') or '')[:60],
                         'by':getattr(r,'reviewed_by','') or '-'} for r in _r]
        try: hitl_rows=_run_in_new_loop(_lh(project_id))
        except Exception: hitl_rows=[]
        review_html=_to_html(_rev) if _rev.strip() else ''
        reflection_html=_to_html(_ref) if _ref.strip() else ''

        # --- 摘要 ---
        _p=[_x.strip() for _x in ps.split('\n\n') if _x.strip()]
        abstract_bg=_p[0] if _p else (_clean(proj.research_question or '')[:400])
        abstract_method=('基于 Qwen 多智能体架构，由知识缺口识别、文献综述、假设生成、研究设计、实验规划、'
          '数据分析、学术写作、评审、反思九个智能体协作，结合数值模拟与统计推断实现假设的可验证性量化。')
        abstract_result=('形成 5 条可验证假设（H1–H5），并通过数值实验及 XENON/Planck/SDSS 等数据集推演，'
          '验证其中 H1（WIMPs 直接探测）与 H3（动态暗能量）具备明确的可操作检验路径。')

        ps_html=_to_html(ps); rationale_html=_to_html(rationale)
        methods_html=_md_section_html(methods); abstract_bg_html=_to_html(abstract_bg)

        # ============ 末尾统一清洗（覆盖所有传给模板的变量，杜绝 ACDM/la型/一一）============
        def _pol(_x):
            if isinstance(_x,str):
                for _a,_b in [('$Λ$CDM','ΛCDM'),('$\\Lambda$CDM','ΛCDM'),('\\CDM','ΛCDM'),('ACDM','ΛCDM')]:
                    _x=_x.replace(_a,_b)
                _x=_re.sub(r'la\s*型','Ia型',_x)
                _x=_re.sub(r'[Tt]ype\s+la\b','type Ia',_x)
                _x=_x.replace('一一','——').replace('$$','').replace('$','')
            return _x
        ps=_pol(ps);rationale=_pol(rationale);methods=_pol(methods);bl=_pol(bl)
        metrics=_pol(metrics);paper_title=_pol(paper_title);results=_pol(results)
        abstract_bg=_pol(abstract_bg);abstract_method=_pol(abstract_method);abstract_result=_pol(abstract_result)
        refs=[_pol(_r) for _r in refs]
        datasets=[{_k:_pol(_v) for _k,_v in _d.items()} for _d in datasets]
        hyp_rows=[{_k:_pol(_v) for _k,_v in _h.items()} for _h in hyp_rows]
        results_rows=[{_k:_pol(_v) for _k,_v in _r.items()} for _r in results_rows]
        ps_html=_pol(ps_html);rationale_html=_pol(rationale_html)
        methods_html=_pol(methods_html);abstract_bg_html=_pol(abstract_bg_html)
        review_html=_pol(review_html);reflection_html=_pol(reflection_html)

        html = tpl.render(
            project=proj, hypotheses=hyp_rows, questions=qs, charts=chart_files, problem_statement=ps, problem_statement_html=ps_html, datasets=datasets, baselines=bl, metrics=metrics, results=results, methods=methods, methods_html=methods_html, results_rows=results_rows, paper_title=paper_title, abstract_bg=abstract_bg, abstract_bg_html=abstract_bg_html, abstract_method=abstract_method, abstract_result=abstract_result, rationale=rationale, rationale_html=rationale_html, references=refs, model_stats=model_stats, hitl_rows=hitl_rows, review_html=review_html, reflection_html=reflection_html, total_tokens=total_tokens, total_cost=total_cost,
            generated_at=datetime.now().strftime('%Y-%m-%d %H:%M')
        )
        out_dir = AUTO_EXPORT_DIR
        out_dir.mkdir(parents=True, exist_ok=True)
        pdf_path = out_dir / f"challenge_cup_project_{project_id}.pdf"
        pdf_path = _resolve_writable_path(pdf_path)
        weasyprint.HTML(string=html).write_pdf(str(pdf_path))
        logger.info(f"[ChallengeCupPDF] 已生成: {pdf_path}")
        # [fix-final-C] 把 PDF 路径回写到关联的 QuestionTask.result
        async def _writeback_pdf(_path: str):
            try:
                from app.database.session import AsyncSessionLocal
                async with AsyncSessionLocal() as _db:
                    from app.database.models import ScienceQuestion as _SQ, QuestionTask as _QT
                    _sq = (await _db.execute(
                        select(_SQ).where(_SQ.question_id == project_id)
                    )).scalar_one_or_none()
                    if _sq is not None:
                        _task = (await _db.execute(
                            select(_QT).where(_QT.question_id == _sq.question_id)
                        )).scalar_one_or_none()
                        if _task is not None:
                            _r = dict(_task.result or {})
                            _r["report_pdf"] = str(_path)
                            _task.result = _r
                            await _db.commit()
                            logger.info(f"[export] pdf {_path} -> task {_task.id}")
            except Exception as _e:
                logger.error(f"[export] report_pdf writeback error: {_e}")

        try:
            _run_in_new_loop(_writeback_pdf(str(pdf_path)))
        except Exception as _e:
            logger.error(f"[export] asyncio.run writeback error: {_e}")

        return str(pdf_path)
    except Exception as e:
        logger.error(f"[ChallengeCupPDF] 生成失败: {e}")
        return None


# ===== 赛题报告导出接口（供前端 P1-P20 按钮调用）=====
from fastapi.responses import Response

@router.get("/competition-report/{project_id}")
def competition_report(project_id: int, format: str = "markdown", db: AsyncSession = Depends(get_db)):
    """
    返回对齐赛题（P1-P20）的完整研究报告。
    format = 'markdown' -> text/markdown (final_output)
    format = 'pdf'      -> 调用 generate_challenge_cup_pdf 生成图文 PDF
    """
    from app.database.models import Project
    async def _load_project():
        from app.database.session import AsyncSessionLocal
        async with AsyncSessionLocal() as _db2:
            return (await _db2.execute(select(Project).where(Project.id == project_id))).scalar_one_or_none()
    project = _run_in_new_loop(_load_project())
    if not project:
        raise HTTPException(404, "项目不存在")

    if format == "pdf":
        pdf_path = generate_challenge_cup_pdf(project_id)
        if not pdf_path or not os.path.exists(pdf_path):
            raise HTTPException(500, "PDF 生成失败，请先确保流水线已完整运行并产出图表")
        return Response(open(pdf_path, "rb").read(), media_type="application/pdf",
                        headers={"Content-Disposition": f'attachment; filename="challenge_cup_project_{project_id}.pdf"'})

    # markdown：直接返回完整 final_output（含占位图表说明）
    md = project.final_output or ""
    if not md:
        raise HTTPException(404, "报告尚未生成（final_output 为空）")
    return Response(md, media_type="text/markdown; charset=utf-8",
                    headers={"Content-Disposition": f'attachment; filename="report_{project_id}.md"'})


