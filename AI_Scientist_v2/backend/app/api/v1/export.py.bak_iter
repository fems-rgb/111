          '（2）上下文工程创新：通过候选假设表强制注入机制，保证写作、设计与分析环节共享同一份 H1–H5 编号与内容，'
          '从根本上解决多智能体各自编号导致的假设错位问题；（3）人机协同创新：引入评审与反思双智能体构成'
          '“生成—评审—反思—迭代”闭环，并支持驳回重做、跳过、中止、重启步骤等人工介入，'
          '使科研过程具备可追溯性与教学意义。')

        # --- 方法论 ---
        methods=''
        _mm=list(_re.finditer(r'^[ \t]*(?:#{1,6}[ \t]*)?方法论[^\n]*\n',writing,_re.M))
        _me=list(_re.finditer(r'^#+[ \t]*(?:实验设计|实验结果)[^\n]*\n',writing,_re.M))
        if _mm:
            _s0=_mm[-1].end(); _cand=[m.start() for m in _me if m.start()>_s0]
            methods=writing[_s0:(min(_cand) if _cand else len(writing))]
        methods=_clean_light(methods)[:5000]
        methods=_re.sub(r'^[六6七7八8九9]\s*[、.]\s*(方法论|实验设计|实验结果)\s*','',methods).strip()
        methods=_re.sub(r'\n[六6七7八8九9]\s*[、.]\s*(方法论|实验设计|实验结果)\s*','\n',methods)
        if len(methods.strip())<60:
            logger.warning('[stageE] 方法论提取为空(writing未输出方法论章节)，尝试从 design 补充')
            _dgn=_clean(_ex.get('design',''))[:3000]
            if len(_dgn.strip())>60:
