        if not isinstance(results_rows,list): results_rows=[]
        _MAP=[('额外维度','H4'),('暗能量','H3'),('膨胀','H3'),('红移','H3'),('CMB','H2'),
              ('轴子','H2'),('势场','H1'),('暗物质','H1')]
