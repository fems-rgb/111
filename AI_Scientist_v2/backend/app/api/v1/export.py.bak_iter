                _r['variables']='、'.join(_VC.get(_p.strip(),_p.strip()) for _p in _vs.split(',') if _p.strip())
                for _k in list(_r.keys()):
                    if isinstance(_r[_k],str) and len(_r[_k])>180: _r[_k]=_r[_k][:180]+'…'
        results=_clean(analysis)[:800] if analysis else ''
        metrics=('假设可验证性 testability_score（1-10）、可证伪性 falsifiability_score（1-10）、'
                 '证据一致性 evidence_consistency（1-10）；统计推断采用线性回归与相关系数显著性检验（p<0.05）。')

        # --- 数据集 ---
        datasets=[]
        _ALL=[('XENON','XENON1T/XENONnT 直接探测实验公开数据','核反冲能量谱、事件率、本底噪声水平'),
              ('Planck','Planck 卫星 CMB 功率谱数据','CMB 温度/偏振功率谱、冷暗物质密度参数'),
