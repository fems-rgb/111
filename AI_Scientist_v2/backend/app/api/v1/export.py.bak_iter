                         '④将假设操作化为可统计检验命题；⑤设计实验（含基线对比与评估指标）；⑥数值模拟执行并产出图表；⑦多轮反思迭代。')
        logger.info('[stageE] 方法论长度=%s', len(methods))
        # [v4] 用假设表 H1-H5 的 suggested_method/variables 构建方法论，严格对齐第四节
        _hm=[]
        for _h in (_hs or []):
            _hid=str(getattr(_h,'hypo_id','') or '').strip()
            _hst=str(getattr(_h,'statement','') or '').strip()
            _hv=str(getattr(_h,'variables','') or '').strip()
            _hsm=str(getattr(_h,'suggested_method','') or '').strip()
            _hec=str(getattr(_h,'evidence_chain','') or '').strip()
            _hm.append("### 假设%s：%s\n- 变量：%s\n- 验证方法：%s\n- 证据链：%s" % (_hid,_hst,_hv,_hsm,_hec))
        if _hm:
