def _safe(val, fallback="（无数据）"):
    """安全取值，None/空字符串返回fallback"""
    if val is None:
        return fallback
    s = str(val).strip()
    return s if s else fallback


def _hypo_table(hypos: list) -> str:
    """将假设列表渲染为Markdown表格"""
    if not hypos:
        return "（本轮未生成假设）"
    rows = ["| # | 假设陈述 | 方向 | 可验证性评分 | 状态 |",
            "|---|---------|------|-------------|------|"]
    for i, h in enumerate(hypos, 1):
        stmt = _safe(getattr(h, "statement", None))[:80]
        direction = _safe(getattr(h, "direction", None))
        score = getattr(h, "verifiability_score", None)
        score_str = f"{score}/10" if score is not None else "—"
        status = _safe(getattr(h, "status", None))
        rows.append(f"| H{i} | {stmt} | {direction} | {score_str} | {status} |")
    return "\n".join(rows)


def _iter_table(iters: list) -> str:
    """将迭代记录渲染为Markdown表格"""
    if not iters:
        return "首轮运行，暂无迭代记录。后续可通过验证与对照模块触发迭代。"
    rows = ["| 轮次 | 发现问题 | 调整措施 | 调整后结果 |",
            "|------|---------|---------|-----------|"]
    for it in iters:
        num = getattr(it, "iteration_num", "?")
        issue = _safe(getattr(it, "issue_found", None))[:100]
        action = _safe(getattr(it, "adjustment", None))[:100]
        result = _safe(getattr(it, "result_after", None))[:100]
        rows.append(f"| {num} | {issue} | {action} | {result} |")
    return "\n".join(rows)


def _task_summary(tasks: list) -> str:
    """将任务列表渲染为流水线摘要表"""
    if not tasks:
        return "| （无任务记录） | — | — | — | — |"
    rows = ["| 步骤 | 智能体 | 输入摘要 | 输出摘要 | 关键指标 |",
            "|------|--------|---------|---------|-----------|"]
    for t in tasks:
        step = getattr(t, "step_order", "?")
        agent = _safe(getattr(t, "agent_name", None))
        inp = _safe(getattr(t, "input_summary", None))[:60]
        out = _safe(getattr(t, "output_summary", None))[:60]
        metric = _safe(getattr(t, "key_metric", None))
        rows.append(f"| {step} | {agent} | {inp} | {out} | {metric} |")
    return "\n".join(rows)


def _extract_structured_field(tasks: list, field_name: str, fallback: str = "[待补充]") -> str:
    """优先从任务result中的结构化JSON提取字段，失败则回退到关键词提取"""
    import json as _json
    for t in tasks:
        result = getattr(t, "result", None)
        if not result:
            continue
        # result可能是dict或str
        data = result if isinstance(result, dict) else None
        if data is None:
            try:
                data = _json.loads(str(result))
            except Exception:
                continue
        # 递归查找field_name
        if isinstance(data, dict) and field_name in data:
            val = data[field_name]
            if isinstance(val, list):
                return chr(10).join(str(v) for v in val) if val else fallback
            return str(val) if val else fallback
        # 嵌套在output字段中
        output = data.get("output", {}) if isinstance(data, dict) else {}
        if isinstance(output, dict) and field_name in output:
            val = output[field_name]
            if isinstance(val, list):
                return chr(10).join(str(v) for v in val) if val else fallback
            return str(val) if val else fallback
    return fallback


def _extract_field_from_tasks(tasks: list, field_keywords: list[str], fallback: str = "[待补充]") -> str:
    """从任务输出中按关键词提取字段内容"""
    for t in tasks:
        output = str(getattr(t, "output_summary", "") or "")
        content = str(getattr(t, "result", "") or "")
        combined = output + content
        for kw in field_keywords:
            if kw in combined:
                snippet = combined[:800]
                return snippet
    return fallback


def _build_p1_to_p20(project: Project, tasks: list, hypotheses: list,
                      iterations: list, team: TeamConfig) -> str:
    """生成符合 XH-202619 12字段标准的 Markdown 报告"""
    # 1. 优先使用 WritingAgent 的完整输出
    for t in tasks:
        if getattr(t, 'agent_name', '') == 'writing':
            out = getattr(t, 'output_data', '')
            if out and out.strip():
                # 检查是否包含12字段标识
                if '## 1. 待研究问题' in out or '## 1. 待研究问题（Problem Statement）' in out:
                    return out
                else:
                    return out

    # 2. 尝试使用 project.final_output
    if project.final_output and project.final_output.strip():
        return project.final_output

    # 3. 回退：生成占位报告
    return """# 科研假设与研究计划（XH-202619）

## 1. 待研究问题（Problem Statement）
（当前项目尚未生成完整报告，请确保 WritingAgent 已执行）

## 2. 解决思路（Rationale）
（待补充）

## 3. 必要的技术手段（Technical Details）
（待补充）

## 4. 数据集（Datasets）
### Source
（待补充）
### Target
（待补充）

## 5. 标题（Paper Title）
（待补充）

## 6. 摘要（Paper Abstract）
（待补充）

## 7. 方法论（Methods）
（待补充）

## 8. 实验设计（Experiments）
（待补充）

## 9. 实验结果（Results）
（待补充）

## 10. 参考论文（References）
（待补充）
"""

def _resolve_writable_path(p):
    """若目标文件被占用(如PDF阅读器打开)，改用带时间戳的新路径，避免 PermissionError。"""
    import time as _t
    if not os.path.exists(p):
        return p
    try:
        with open(p, 'ab'):
            pass
        return p
    except (PermissionError, OSError):
        stem, ext = os.path.splitext(p)
        return f'{stem}_{_t.strftime("%Y%m%d_%H%M%S")}{ext}'

def generate_challenge_cup_pdf(project_id: int) -> str | None:
    """为指定项目生成对标'挑战杯'赛题规范的 PDF，返回 pdf 路径或 None"""
    try:
        import weasyprint
        from jinja2 import Environment, FileSystemLoader
        from app.database.session import AsyncSessionLocal
        from app.database.models import Project, Hypothesis, ScienceQuestion, QuestionTask, ExperimentRun
        import asyncio
        async def _gather():
            async with AsyncSessionLocal() as _db:
                proj = (await _db.execute(
                    select(Project).where(Project.id == project_id))).scalar_one_or_none()
                if not proj:
                    return None
                hyps = (await _db.execute(
                    select(Hypothesis).where(Hypothesis.project_id == project_id)
                    .order_by(Hypothesis.id.desc()).limit(5))).scalars().all()
                # [fix] ScienceQuestion 可能没有 project_id；容错处理
                try:
                    qs = (await _db.execute(
                        select(ScienceQuestion).where(ScienceQuestion.project_id == project_id)
                        .order_by(ScienceQuestion.question_id.desc()).limit(10))).scalars().all()
                except (AttributeError, Exception) as _qe:
                    # 退化：直接取最新的 10 条（不按 project 过滤）
                    try:
                        qs = (await _db.execute(
                            select(ScienceQuestion).order_by(ScienceQuestion.question_id.desc()).limit(10))).scalars().all()
                    except Exception:
                        qs = []
                # [stageD] 查询该项目模拟场运行记录（图表真实来源之一）
                try:
                    runs = (await _db.execute(
                        select(ExperimentRun).where(ExperimentRun.project_id == project_id)
                    )).scalars().all()
                except Exception as _re:
                    logger.warning(f"[stageD] ExperimentRun 查询失败: {_re}")
                    runs = []
                return proj, hyps, qs, runs
        result = _run_in_new_loop(_gather())
        if result is None:
            return None
        proj, hyps, qs, runs = result

        # [stageD] 图表收集：三源合并（修复原只读 hypothesis.result.experiment.charts 导致 PDF 无图）
        # 源1 Project.evidence_files（流水线/模拟场回写，主来源）
        # 源2 ExperimentRun.charts（模拟场产出，元素形如 {'path','filename'}）
        # 源3 hypothesis.result.experiment.charts（兼容旧结构）
        import json as _djson
        _IMG_EXT = ('.png', '.jpg', '.jpeg', '.gif', '.svg', '.bmp', '.webp')
        def _as_list(v):
            if not v: return []
            if isinstance(v, list): return v
            if isinstance(v, str):
                try: return _djson.loads(v)
                except Exception: return []
            return []
        def _add_path(p):
            """[stageD] 转 base64 data URI：模板用 c.b64 渲染，不依赖 WeasyPrint 的 file:// 加载"""
            if p and isinstance(p, str) and os.path.exists(p) and p.lower().endswith(_IMG_EXT):
                try:
                    import base64 as _b64
                    with open(p, 'rb') as _f:
                        _data = _b64.b64encode(_f.read()).decode('ascii')
                    chart_files.append({"b64": _data, "filename": os.path.basename(p)})
                except Exception as _e:
                    logger.warning("[stageD] 转 base64 失败 %s: %s", p, _e)
        chart_files = []
        # --- 源1: Project.evidence_files ---
        for p in _as_list(proj.evidence_files):
            _add_path(p)
        # --- 源2: ExperimentRun.charts ---
        for _r in (runs or []):
            for c in _as_list(getattr(_r, 'charts', None)):
                _add_path(c.get('path','') if isinstance(c, dict) else c)
        # --- 源3: hypothesis.result.experiment.charts ---
        for h in hyps:
            r = h.result or {} if hasattr(h,'result') else {}
            exp = r.get('experiment', {}) if isinstance(r, dict) else {}
            for c in exp.get('charts', []):
                _add_path(c.get('path','') if isinstance(c, dict) else c)
        # 去重保序
        # 去重保序（stageD修复：按 filename 去重，避免 dict 元素导致 unhashable type: 'dict'）
        seen, uniq = set(), []
        for c in chart_files:
            _k = c.get('filename') if isinstance(c, dict) else str(c)
            if _k not in seen:
                seen.add(_k); uniq.append(c)
        chart_files = uniq[:8]

        env = Environment(loader=FileSystemLoader(os.path.join(os.path.dirname(__file__),'templates')))
        tpl = env.get_template('challenge_cup_template.html')






        # [stageE-FINAL] 终版合一
        import re as _re, json as _json

        def _tex_clean(_s):
            if not _s: return _s
            _s = _s.replace('\\left','').replace('\\right','')
            _s = _s.replace('\\_','_')
            for _ in range(6):
                _n = _re.sub(r'\\frac\{([^{}]*)\}\{([^{}]*)\}', r'(\1)/(\2)', _s)
                if _n == _s: break
                _s = _n
            for _c in ['text','mathbf','mathrm','mathit','textbf','textrm','rm','bf','it','operatorname']:
                _s = _re.sub(r'\\' + _c + r'\{([^{}]*)\}', r'\1', _s)
            _SYM = [('\\rho','ρ'),('\\Omega','Ω'),('\\omega','ω'),('\\alpha','α'),('\\beta','β'),
                    ('\\gamma','γ'),('\\delta','δ'),('\\phi','φ'),('\\varphi','φ'),('\\sigma','σ'),
                    ('\\Sigma','Σ'),('\\theta','θ'),('\\Lambda','Λ'),('\\lambda','λ'),('\\mu','μ'),
                    ('\\nu','ν'),('\\pi','π'),('\\tau','τ'),('\\chi','χ'),('\\psi','ψ'),
                    ('\\epsilon','ε'),('\\kappa','κ'),('\\approx','≈'),('\\sim','∼'),('\\propto','∝'),
                    ('\\odot','⊙'),('\\pm','±'),('\\times','×'),('\\cdot','·'),('\\neq','≠'),('\\ne','≠'),
                    ('\\leq','≤'),('\\le','≤'),('\\geq','≥'),('\\ge','≥'),('\\ll','≪'),('\\gg','≫'),
                    ('\\rightarrow','→'),('\\to','→'),('\\in','∈'),('\\partial','∂'),('\\nabla','∇'),
                    ('\\infty','∞'),('\\ldots','…'),('\\dots','…'),('\\mid','|'),('\\quad',' '),('\\,',' ')]
            for _a,_b in _SYM: _s = _s.replace(_a,_b)
            _s = _re.sub(r'\^\s*\{([^{}]*)\}', r'^\1', _s)
            _s = _re.sub(r'_\s*\{([^{}]*)\}', r'_\1', _s)
            _s = _s.replace('\\{','{').replace('\\}','}')
            _s = _re.sub(r'\\[A-Za-z]+','',_s)
            _s = _s.replace('{','').replace('}','').replace('\\','')
            _s = _re.sub(r'[ \t]{2,}',' ',_s)
            return _s.strip()

        def _clean(_t):
            if not _t: return ''
            _t = _re.sub(r'```mermaid.*?```','',_t,flags=_re.S)
            _t = _re.sub(r'```[A-Za-z]*','',_t)
            # \( \) 与 \[ \] 行内/行间公式
            _t = _re.sub(r'\\\((.*?)\\\)', lambda m: _tex_clean(m.group(1)), _t, flags=_re.S)
            _t = _re.sub(r'\\\[(.*?)\\\]', lambda m: _tex_clean(m.group(1)), _t, flags=_re.S)
            _t = _re.sub(r'\$\$(.*?)\$\$', lambda m: _tex_clean(m.group(1)), _t, flags=_re.S)
            _t = _re.sub(r'\$(.*?)\$', lambda m: _tex_clean(m.group(1)), _t, flags=_re.S)
            _t = _t.replace('$$','')
            _t = _re.sub(r'\\Omega_\{?c\}?\s*h\^\{?2\}?','Omega_c h^2',_t)
            for _a,_b in [('\\Lambda','Λ'),('\\Omega','Ω'),('\\alpha','α'),('\\beta','β'),
                          ('\\sigma','σ'),('\\chi','χ'),('\\pm','±'),('\\times','×'),('\\approx','≈')]:
                _t = _t.replace(_a,_b)
            _t = _re.sub(r'^[ \t]*#{1,6}[ \t]*','',_t,flags=_re.M)
            _t = _re.sub(r'\*\*(.+?)\*\*',r'\1',_t)
            _t = _re.sub(r'^\s*[-─=]{3,}\s*$','',_t,flags=_re.M)
            _t = _re.sub(r'\n{3,}','\n\n',_t)
            return _t.strip()

        def _clean_light(_t):
            _t = _re.sub(r'```mermaid.*?```','',_t,flags=_re.S)
            _t = _re.sub(r'```[A-Za-z]*','',_t)
            _t = _re.sub(r'\\\((.*?)\\\)', lambda m: _tex_clean(m.group(1)), _t, flags=_re.S)
            _t = _re.sub(r'\\\[(.*?)\\\]', lambda m: _tex_clean(m.group(1)), _t, flags=_re.S)
            _t = _re.sub(r'\$\$(.*?)\$\$', lambda m: _tex_clean(m.group(1)), _t, flags=_re.S)
            _t = _re.sub(r'\$(.*?)\$', lambda m: _tex_clean(m.group(1)), _t, flags=_re.S)
            _t = _t.replace('$$','')
            _t = _re.sub(r'\\Omega_\{?c\}?\s*h\^\{?2\}?','Omega_c h^2',_t)
            for _a,_b in [('\\Lambda','Λ'),('\\Omega','Ω'),('\\alpha','α'),('\\beta','β'),
                          ('\\sigma','σ'),('\\chi','χ'),('\\pm','±'),('\\times','×'),('\\approx','≈')]:
                _t = _t.replace(_a,_b)
            _t = _re.sub(r'\*\*(.+?)\*\*',r'\1',_t)
            return _t

        def _md_section_html(_t):
            if not _t: return '<p></p>'
            _out=[];_buf=[];_tbl=[]
            def _fb():
                if _buf: _out.append('<p>'+'<br>'.join(_buf)+'</p>'); _buf.clear()
            def _cl(_r): return [c.strip() for c in _r.strip().strip('|').split('|')]
            def _ft():
                if not _tbl: return
                _h=_cl(_tbl[0]);_rows=[]
                for _r in _tbl[1:]:
                    if not _r.strip().strip('|').replace('-','').replace(':','').replace('|','').replace(' ',''): continue
                    _rows.append(_cl(_r))
                if not _rows: _tbl.clear(); return
                s='<table><thead><tr>'+''.join('<th>%s</th>'%c for c in _h)+'</tr></thead><tbody>'
                for _r in _rows: s+='<tr>'+''.join('<td>%s</td>'%c for c in _r)+'</tr>'
                _out.append(s+'</tbody></table>'); _tbl.clear()
            for _ln in _t.split('\n'):
                _s=_ln.strip()
                if _s.startswith('|') and _s.endswith('|') and _s.count('|')>=2: _tbl.append(_s); continue
                if _tbl: _ft()
                if not _s: _fb(); continue
                _m=_re.match(r'^#{1,6}[ \t]*(.+)$',_s)
                if _m: _fb(); _out.append('<h4>'+_m.group(1).strip()+'</h4>')
                else: _buf.append(_s)
            if _tbl: _ft()
            _fb()
            return ''.join(_out) if _out else '<p></p>'

        def _to_html(_t):
            if not _t: return '<p></p>'
            ps=[]
            for _p in _t.split('\n\n'):
                _s=_p.strip()
                if _s: ps.append('<p>'+_s.replace('\n','<br>')+'</p>')
            return ''.join(ps) if ps else '<p></p>'

        def _br(_t): return str(_t).replace('\n','<br>') if _t else ''

        def _strip_heading(_t,*w):
            for _x in w:
                _t=_re.sub(r'^[\s#]*'+_x+r'[（(][^)）]*[)）]\s*','',_t)
                _t=_re.sub(r'^[\s#]*'+_x+r'\s*','',_t)
            return _t.strip()

        # --- 图表去重 ---
        _seen=set();_uc=[]
        import base64 as _b64, os as _os, glob as _glob
        _EXP=r'D:\\AI_Scientist\\AI_Scientist\\backend\\output\\experiments'
        _all_png={_os.path.basename(_p):_p for _p in _glob.glob(_EXP+r'\\**\\*.png', recursive=True)}
        logger.info('[stageE] 目录中png共%s个: %s', len(_all_png), list(_all_png.keys())[:5])
        def _add_ch(_c):
            if not isinstance(_c,dict): return
            if not _c.get('b64'):
                _p=_c.get('path') or _c.get('file') or _c.get('filepath')
                _fn=_c.get('filename') or (_os.path.basename(_p) if _p else '')
                if (not _p or not _os.path.exists(_p)) and _fn in _all_png:
                    _p=_all_png[_fn]
                if _p and _os.path.exists(_p):
                    try:
                        with open(_p,'rb') as _f:
                            _c=dict(_c); _c['b64']=_b64.b64encode(_f.read()).decode('ascii')
                            _c.setdefault('title',_os.path.basename(_p))
                    except Exception as _be:
                        logger.warning('[stageE] 读图失败 %s', _be)
            _bb=_c.get('b64')
            if _bb and _bb not in _seen:
                _seen.add(_bb); _uc.append(_c)
        for _c in (chart_files or []): _add_ch(_c)
        if not _uc:
            for _fn,_p in sorted(_all_png.items())[:6]:
                _add_ch({'filename':_fn,'path':_p})
        chart_files=_uc
        logger.info('[stageE] 图表数=%s 有b64=%s', len(chart_files), sum(1 for _c in chart_files if _c.get('b64')))

        # --- 假设 ---
        try: _hs=sorted(hyps,key=lambda x:str(getattr(x,'hypo_id','') or ''))
        except Exception: _hs=list(hyps)
        hyp_rows=[]
        for _h in _hs:
            _v=getattr(_h,'variables',None)
            if isinstance(_v,str):
                try: _v=_json.loads(_v)
                except Exception: pass
            if isinstance(_v,list): _v='、'.join(str(_x) for _x in _v)
            _ec=_re.sub(r'^["“”\']+|["“”\']+$','',str(getattr(_h,'evidence_chain','') or ''))
            hyp_rows.append({'hypo_id':_br(getattr(_h,'hypo_id','')),
                'statement':_br(getattr(_h,'statement','')),
                'variables':_br(_v or ''),
                'testability_score':getattr(_h,'testability_score',''),
                'suggested_method':_br(getattr(_h,'suggested_method','')),
                'evidence_chain':_br(_ec)})

        # --- 模型统计 ---
        async def _ls(pid):
            from app.database.session import AsyncSessionLocal
            async with AsyncSessionLocal() as _d:
                _r=(await _d.execute(select(AgentTask).where(AgentTask.project_id==pid))).scalars().all()
                return [{'agent':r.agent_name,'model':r.model_used or '-','tokens':r.tokens_used or 0,
                         'cost':round(float(r.cost_yuan or 0),4)} for r in _r]
        try: model_stats=_run_in_new_loop(_ls(project_id))
        except Exception as _e: logger.warning('[stageE] stats %s',_e); model_stats=[]
        total_tokens=sum(int(s['tokens']) for s in model_stats)
        total_cost=round(sum(float(s['cost']) for s in model_stats),4)

        async def _lx(pid):
            from app.database.session import AsyncSessionLocal
            async with AsyncSessionLocal() as _d:
                _r=(await _d.execute(select(AgentTask).where(AgentTask.project_id==pid))).scalars().all()
                return dict((r.agent_name,(r.output_data or '')) for r in _r)
        try: _ex=_run_in_new_loop(_lx(project_id))
        except Exception as _e: logger.warning('[stageE] extract %s',_e); _ex={}
        writing=_ex.get('writing','');analysis=_ex.get('analysis','')
        exp_plan=_ex.get('experiment_plan','');lit=_ex.get('literature','');kg=_ex.get('knowledge_gap','')

        # --- 待研究问题（赛题要求：具体局限性）---
        ps='';_best=''
        for _m in _re.finditer(r'#+[ \t]*待研究问题[^\n]*\n+(.*?)(?=\n#+|\Z)',writing,_re.S):
            if len(_m.group(1).strip())>len(_best): _best=_m.group(1)
        ps=_strip_heading(_clean(_best),'待研究问题',r'Problem\s*Statement')
