
def _run_in_new_loop(coro):
    """在独立线程的全新事件循环里执行 coro"""
    import asyncio as _aio
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=1) as _pool:
        return _pool.submit(_aio.run, coro).result()
def _safe_run(coro):
    """在独立线程的全新事件循环里执行 coro，避免 asyncio.run() cannot be called from a running event loop"""
    import asyncio as _aio
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=1) as _pool:
        return _pool.submit(_aio.run, coro).result()

