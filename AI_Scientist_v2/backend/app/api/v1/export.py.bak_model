# ===== 自动PDF导出配置 =====
AUTO_EXPORT_DIR = Path(__file__).resolve().parent.parent.parent.parent / "output" / "pdf_reports"


def md_to_pdf(md_content: str, pdf_path: str, title: str = "Report") -> bool:
    """将 Markdown 内容转换为 PDF 文件（同步函数，供 questions.py 等直接调用）
    优先使用 WeasyPrint（更好的中文支持），失败则回退到 xhtml2pdf"""
    # 唯一文件名：避免多任务并发写同一路径导致 PermissionError
    import os as _os, time as _time, random as _random, string as _string
    if pdf_path and pdf_path.endswith("report.pdf"):
        _base = pdf_path[:-len("report.pdf")]
        _stamp = _time.strftime("%Y%m%d_%H%M%S")
        _suf = ''.join(_random.choices(_string.ascii_lowercase + _string.digits, k=6))
        pdf_path = f"{_base}report_{_stamp}_{_suf}.pdf"
    """将 Markdown 内容转换为 PDF 文件（同步函数，供 questions.py 等直接调用）
    优先使用 WeasyPrint（更好的中文支持），失败则回退到 xhtml2pdf"""
    # 方案1: WeasyPrint (推荐，中文支持好)
    try:
        import weasyprint
        import markdown as md_lib
        html_body = md_lib.markdown(md_content, extensions=['tables', 'fenced_code'])
        full_html = f"""<!DOCTYPE html><html><head><meta charset="utf-8">
<style>
@page {{ size: a4 portrait; margin: 20mm 15mm; }}
body {{ font-family: 'Microsoft YaHei', 'SimHei', sans-serif; line-height: 1.8; font-size: 11pt; }}
h1 {{ color: #1a237e; border-bottom: 3px solid #1a237e; padding-bottom: 6px; font-size: 16pt; page-break-before: always; }}
h2 {{ color: #283593; font-size: 13pt; border-bottom: 1px solid #ccc; }}
table {{ border-collapse: collapse; width: 100%; margin: 10px 0; font-size: 9.5pt; }}
th, td {{ border: 1px solid #ddd; padding: 5px 8px; text-align: left; }}
th {{ background-color: #f5f5f5; }}
pre {{ background: #f5f5f5; padding: 8px; border-radius: 4px; overflow-x: auto; }}
code {{ font-family: 'Courier New', monospace; font-size: 9pt; }}
</style>
</head><body>{html_body}</body></html>"""
        doc = weasyprint.HTML(string=full_html)
        doc.write_pdf(pdf_path)
        logger.info(f"[WeasyPrint] PDF 生成成功: {pdf_path}")
        return True
    except Exception as e:
        logger.warning(f"[WeasyPrint] 失败，回退到 xhtml2pdf: {e}")
    # 方案2: xhtml2pdf (回退)
    try:
        from xhtml2pdf import pisa
        import markdown as md_lib
    except ImportError:
        logger.warning("xhtml2pdf/markdown 未安装，无法生成PDF")
        return False

    html_body = md_lib.markdown(md_content, extensions=['tables', 'fenced_code'])
    full_html = f"""<!DOCTYPE html><html><head><meta charset="utf-8">
<style>
@page {{ size: a4 portrait; margin: 20mm 15mm; }}
body {{ font-family: 'Microsoft YaHei', 'SimHei', 'Noto Sans CJK SC', STSong-Light, sans-serif; line-height: 1.8; font-size: 11pt; }}
h1 {{ color: #1a237e; border-bottom: 3px solid #1a237e; padding-bottom: 6px; font-size: 16pt; -pdf-keep-with-next: true; page-break-before: always; }}
h2 {{ color: #283593; font-size: 13pt; border-bottom: 1px solid #ccc; -pdf-keep-with-next: true; }}
table {{ border-collapse: collapse; width: 100%; margin: 10px 0; font-size: 9.5pt; }}
th, td {{ border: 1px solid #ddd; padding: 5px 8px; text-align: left; }}
th {{ background-color: #e8eaf6; }}
pre {{ background-color: #f5f5f5; padding: 10px; font-size: 9pt; }}
code {{ background-color: #f5f5f5; padding: 1px 4px; }}
</style></head><body>{html_body}</body></html>"""

    Path(pdf_path).parent.mkdir(parents=True, exist_ok=True)
    buf = io.BytesIO()
    status = pisa.CreatePDF(full_html, dest=buf, encoding='utf-8')
    if status.err:
        logger.error(f"md_to_pdf xhtml2pdf errors: {status.err}")
        return False

    Path(pdf_path).write_bytes(buf.getvalue())
    logger.info(f"✅ md_to_pdf 成功: {pdf_path} ({len(buf.getvalue())} bytes)")
    return True



async def auto_export_pdf(project_id: int, db: AsyncSession) -> str | None:
    """自动生成PDF并保存到 output/pdf_reports/ 目录，返回文件路径"""
    try:
        from xhtml2pdf import pisa
        import markdown as md_lib
    except ImportError:
        logger.warning("xhtml2pdf/markdown 未安装，跳过自动PDF导出")
        return None

    proj = (await db.execute(
        select(Project).where(Project.id == project_id)
    )).scalar_one_or_none()
    if not proj:
        logger.error(f"auto_export_pdf: project {project_id} not found")
        return None

    tasks_r = await db.execute(select(AgentTask).where(AgentTask.project_id == project_id))
    hypos_r = await db.execute(select(Hypothesis).where(Hypothesis.project_id == project_id))
    iters_r = await db.execute(select(IterationRecord).where(IterationRecord.project_id == project_id))
    tasks = tasks_r.scalars().all()
    hypos = hypos_r.scalars().all()
    iters = iters_r.scalars().all()

    team = TeamConfig()
    if proj.competition_config:
        try:
            d = safe_json_parse(proj.competition_config, fallback={}, label="auto_export")
            team = TeamConfig(**{k: v for k, v in d.items() if k in TeamConfig.model_fields})
        except Exception:
            pass

    md_text = _build_p1_to_p20(proj, tasks, hypos, iters, team)
    html_body = md_lib.markdown(md_text, extensions=['tables', 'fenced_code'])
    full_html = f"""<!DOCTYPE html><html><head><meta charset="utf-8">
<style>
@page {{ size: a4 portrait; margin: 20mm 15mm; }}
body {{ font-family: 'Microsoft YaHei', 'SimHei', 'Noto Sans CJK SC', STSong-Light, sans-serif; line-height: 1.8; font-size: 11pt; }}
h1 {{ color: #1a237e; border-bottom: 3px solid #1a237e; padding-bottom: 6px; font-size: 16pt; -pdf-keep-with-next: true; page-break-before: always; }}
h2 {{ color: #283593; font-size: 13pt; border-bottom: 1px solid #ccc; -pdf-keep-with-next: true; }}
table {{ border-collapse: collapse; width: 100%; margin: 10px 0; font-size: 9.5pt; }}
th, td {{ border: 1px solid #ddd; padding: 5px 8px; text-align: left; }}
th {{ background-color: #e8eaf6; }}
pre {{ background-color: #f5f5f5; padding: 10px; font-size: 9pt; }}
code {{ background-color: #f5f5f5; padding: 1px 4px; }}
</style></head><body>{html_body}</body></html>"""

    AUTO_EXPORT_DIR.mkdir(parents=True, exist_ok=True)
    ts = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    safe_name = "".join(c if c.isalnum() or c in "-_" else "_" for c in (proj.name or f"project_{project_id}"))[:60]
    filename = f"{COMPETITION['topic_id']}_{safe_name}_{ts}.pdf"
    filepath = AUTO_EXPORT_DIR / filename

    buf = io.BytesIO()
    status = pisa.CreatePDF(full_html, dest=buf, encoding='utf-8')
    if status.err:
        logger.error(f"auto_export_pdf xhtml2pdf errors: {status.err}")
        return None

    filepath.write_bytes(buf.getvalue())
    logger.info(f"✅ PDF自动导出成功: {filepath} ({len(buf.getvalue())} bytes)")
    return str(filepath)


