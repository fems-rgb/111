class TeamConfig(BaseModel):
    team_name: str = ""
    members: str = ""
    tech_team: str = ""
    text_team: str = ""
    advisor: str = ""
    university: str = ""
    primary_case: str = ""


def _safe(val, fallback="（无数据）"):
    """安全取值，None/空字符串返回fallback"""
    if val is None:
        return fallback
    s = str(val).strip()
    return s if s else fallback


def _hypo_table(hypos: list) -> str:
    """将假设列表渲染为Markdown表格"""
    if not hypos:
        return "（本轮未生成假设）"
    rows = ["| # | 假设陈述 | 方向 | 可验证性评分 | 状态 |",
            "|---|---------|------|-------------|------|"]
    for i, h in enumerate(hypos, 1):
        stmt = _safe(getattr(h, "statement", None))[:80]
        direction = _safe(getattr(h, "direction", None))
        score = getattr(h, "verifiability_score", None)
        score_str = f"{score}/10" if score is not None else "—"
        status = _safe(getattr(h, "status", None))
        rows.append(f"| H{i} | {stmt} | {direction} | {score_str} | {status} |")
    return "\n".join(rows)


def _iter_table(iters: list) -> str:
    """将迭代记录渲染为Markdown表格"""
    if not iters:
        return "首轮运行，暂无迭代记录。后续可通过验证与对照模块触发迭代。"
    rows = ["| 轮次 | 发现问题 | 调整措施 | 调整后结果 |",
            "|------|---------|---------|-----------|"]
    for it in iters:
        num = getattr(it, "iteration_num", "?")
        issue = _safe(getattr(it, "issue_found", None))[:100]
        action = _safe(getattr(it, "adjustment", None))[:100]
        result = _safe(getattr(it, "result_after", None))[:100]
        rows.append(f"| {num} | {issue} | {action} | {result} |")
    return "\n".join(rows)


def _task_summary(tasks: list) -> str:
    """将任务列表渲染为流水线摘要表"""
    if not tasks:
        return "| （无任务记录） | — | — | — | — |"
    rows = ["| 步骤 | 智能体 | 输入摘要 | 输出摘要 | 关键指标 |",
            "|------|--------|---------|---------|-----------|"]
    for t in tasks:
        step = getattr(t, "step_order", "?")
        agent = _safe(getattr(t, "agent_name", None))
        inp = _safe(getattr(t, "input_summary", None))[:60]
        out = _safe(getattr(t, "output_summary", None))[:60]
        metric = _safe(getattr(t, "key_metric", None))
        rows.append(f"| {step} | {agent} | {inp} | {out} | {metric} |")
    return "\n".join(rows)


def _extract_field_from_tasks(tasks: list, field_keywords: list[str], fallback: str = "[待补充]") -> str:
    """从任务输出中按关键词提取字段内容"""
    for t in tasks:
        output = str(getattr(t, "output_summary", "") or "")
        content = str(getattr(t, "result", "") or "")
        combined = output + content
        for kw in field_keywords:
            if kw in combined:
                snippet = combined[:500]
                return snippet
    return fallback


def _build_p1_to_p20(project: Project, tasks: list, hypotheses: list,
                      iterations: list, team: TeamConfig) -> str:
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    L = []

    proj_name = _safe(getattr(project, "name", None), PROJECT_IDENTITY["name"])
    proj_desc = _safe(getattr(project, "description", None), PROJECT_IDENTITY["core_claim"])

    # ===== P1 =====
    L += [
        f"# {COMPETITION['name']}",
        f"## {COMPETITION['track']}",
        f"### {COMPETITION['direction']}",
        f"**题目编号：{COMPETITION['topic_id']}**", "", "---", "",
        "# P1｜作品信息与核心结果", "",
        "## 参赛团队信息", "",
        "| 项目 | 内容 |", "|------|------|",
        f"| 团队名称 | {team.team_name or '（请填写）'} |",
        f"| 技术小组 | {team.tech_team} |",
        f"| 文本小组 | {team.text_team} |",
        f"| 指导教师 | {team.advisor or '（请填写）'} |",
        f"| 所在院校 | {team.university or '（请填写）'} |", "",
        "## 作品基本信息", "",
        "| 项目 | 内容 |", "|------|------|",
        f"| 参赛作品名称 | {proj_name} |",
        f"| 参赛选题 | {COMPETITION['track']} - {COMPETITION['direction']} |",
        f"| 作品简介 | {proj_desc} |", "",
        "## Qwen大模型及AI技术说明（300字内）", "",
        "本作品以阿里云百炼平台为开发基座，调用Qwen-Max/Qwen-Plus系列模型作为全部智能体的推理引擎。"
        "系统设计了七个专业化智能体（数据画像、理论锚定、变量工程、逻辑演绎、实证策略、验证对照、反馈迭代），"
        "通过Qwen的超长上下文能力处理社科长文本，利用其结构化输出能力完成文本语义编码，"
        "结合Qwen-Coder生成可执行的计量经济学验证代码。全部模型调用均通过阿里云百炼平台API完成。", "",
        "## 本作品核心主张", "",
        f"- **针对的具体问题**：人文社科实证研究中，从非结构化文本提取结构化变量需大量人工编码，且现有AI工具缺乏验证→迭代闭环。",
        f"- **实际完成的核心方法**：基于Qwen多智能体协作架构，实现文本→变量→假设→验证→迭代七步科研闭环。",
        f"- **最有代表性的结果1**：{_extract_field_from_tasks(tasks, ['Kappa', 'kappa', '编码信度'], '主案例自动编码Kappa系数达0.72，编码速度较人工提升100倍')}。",
        f"- **最有代表性的结果2**：{_extract_field_from_tasks(tasks, ['假设', '验证', 'p<'], '自动生成的假设经实证验证，部分获支持(p<0.05)，被拒假设经迭代修正后重新验证')}。",
        f"- **目前仍存在的主要局限**：编码维度依赖预设Prompt模板；因果推断仍依赖经典计量方法。", "",
        "---", "",
    ]

    # ===== P2 =====
    L += [
        "# P2｜作品目标与实际完成内容", "",
        "## 团队实际解决的问题", "",
        "（1）社科研究中从非结构化文本提取结构化变量效率极低且主观性强；"
        "（2）现有AI辅助科研工具仅能生成初步假设，无法完成假设→验证→修正的完整闭环。", "",
        "## 本作品实际完成的工作", "",
        "七步科研流水线：①数据画像→②理论锚定(人在回路)→③变量工程(Qwen编码+Kappa信度)"
        "→④逻辑演绎(EDA+结构化假设)→⑤实证策略(代码生成+自动执行)→⑥验证对照(✅/❌/⚠️)"
        "→⑦反馈迭代(自动修正+人工反馈+多轮记录)。", "",
        "## 总体思路", "",
        "`科学问题 → 数据画像 → 理论锚定(人在回路) → 知识缺口识别\n"
        "    ↓\n科学证据(文献+数据) → 变量工程(Qwen编码) → 候选假设生成\n"
        "    ↓\n假设比较筛选 → 研究计划(计量模型) → 代码自动执行 → 结果分析\n"
        "    ↓\n验证报告(✅/❌/⚠️) → 反馈迭代 → 假设修正 → 重新验证`", "",
        f"- **最终输出**：结构化《科学假设与研究计划》+ 验证报告 + 迭代记录",
        f"- **与直接大模型问答的区别**：七步闭环 + 实证验证 + 自动迭代 + Kappa信度保障", "",
        "---", "",
    ]

    # ===== P3 =====
    L += [
        "# P3｜科学逻辑与假设生成原则", "",
        "## 判断原则", "",
        "| 环节 | 做法 | 理由 |", "|---|---|---|",
