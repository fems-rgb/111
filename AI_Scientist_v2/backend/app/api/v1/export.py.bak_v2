        f"| {_extract_field_from_tasks(tasks, ['政策', '制度', 'policy'], '相关政策文件')} | 政府官网/公开数据库 | 控制变量依据 | 地区差异 |", "",
        "---", "",
    ]

    # ===== P5 =====
    L += [
        "# P5｜评价方法", "",
        "| 评价内容 | 方法 | 对象 | 影响 |", "|---|---|---|---|",
        "| 编码质量 | Cohen's Kappa | 标注样本 | <0.7触发Prompt优化 |",
        "| 假设可验证性 | 结构化评分(1-10) | 每条假设 | <6分淘汰 |",
        "| 实证支持度 | p<0.05 + 效应量 | 主+迁移案例 | 不显著→反馈迭代 |",
        "| 稳健性 | 多次重复运行 | 全部测试题 | 不一致>20%标记 |", "",
        "---", "",
    ]

    # ===== P6 =====
    agent_rows = "\n".join([f"| {a[0]} | {a[1]} |" for a in PROJECT_IDENTITY["agents"]])
    L += [
        "# P6｜系统总体架构与技术闭环", "",
        "## 七智能体架构", "",
        "| 智能体 | 核心功能 |", "|---|---|",
        agent_rows, "",
        "## 技术闭环关键设计", "",
        "1. **中间结果进入下一轮**：被拒假设+失败原因→反馈迭代输入",
        "2. **编码结果持久化**：变量工程输出的数值列被缓存，迭代时无需重新编码",
        "3. **人工审核节点**：理论锚定必须人工确认，验证结果支持人工批注", "",
        "---", "",
    ]

    # ===== P7 =====
    L += [
        "# P7｜Qwen使用方式与上下文工程", "",
        "| 内容 | 做法 |", "|---|---|",
        "| 模型 | Qwen-Max(理论/假设/迭代) + Qwen-Plus(画像/编码/验证) + Qwen-Coder(代码) |",
