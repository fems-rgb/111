import os, html, asyncio, logging
from pathlib import Path

logger = logging.getLogger(__name__)

ROOT = Path(r'D:\AI_Scientist\AI_Scientist')
BACKEND = ROOT / 'backend'
AGENTS = BACKEND / 'app' / 'agents'
OUT_DIR = BACKEND / 'output' / 'pdf_reports'


def _run_coro(coro):
    try:
        loop = asyncio.get_running_loop()
    except RuntimeError:
        loop = None
    if loop and loop.is_running():
        import concurrent.futures
        with concurrent.futures.ThreadPoolExecutor() as ex:
            return ex.submit(asyncio.run, coro).result()
    return asyncio.run(coro)


def _read_code_file(fname, start_kw=None, end_kw=None, maxlines=200, whole=False):
    p = AGENTS / fname
    if not p.exists():
        return f"（未找到 {fname}）"
    lines = p.read_text(encoding='utf-8', errors='ignore').split('\n')
    if whole or start_kw is None:
        return html.escape('\n'.join(lines[:maxlines]))
    if not any(start_kw in l for l in lines):
        return f"（源码中未找到标记：{start_kw}）"
    si = next(i for i, l in enumerate(lines) if start_kw in l)
    ei = next((i for i, l in enumerate(lines) if i > si and end_kw in l), min(si + maxlines, len(lines)))
    return html.escape('\n'.join(lines[si:ei+1]))


def generate_competition_proposal(project_id: int):
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    FRONT = OUT_DIR / '_front.pdf'
    BACK = OUT_DIR / '_back.pdf'
    FINAL = OUT_DIR / 'XH-202619_技术方案文档.pdf'

    # --- 读真实数据 ---
    rows, tot_t, tot_c, domain, title_q = [], 0, 0.0, '宇宙学', '宇宙由什么构成？'
    try:
        from sqlalchemy import select
        from app.database.session import AsyncSessionLocal
        from app.database.models import AgentTask, Project

        async def _load(pid):
            async with AsyncSessionLocal() as db:
                rs = (await db.execute(select(AgentTask).where(AgentTask.project_id == pid))).scalars().all()
                p = (await db.execute(select(Project).where(Project.id == pid))).scalar_one_or_none()
                return rs, p

        tasks, proj = _run_coro(_load(project_id))
        for r in tasks:
            rows.append((r.agent_name, r.model_used or '-', r.tokens_used or 0, round(float(r.cost_yuan or 0), 4)))
            tot_t += (r.tokens_used or 0)
            tot_c += float(r.cost_yuan or 0)
        if proj:
            domain = str(getattr(proj, 'domain', '') or domain)
            title_q = str(getattr(proj, 'research_question', '') or title_q)
    except Exception as e:
        logger.warning('[proposal] 数据加载失败: %s', e)

    esc = html.escape
    rows_html = ''.join(
        f'<tr><td>{esc(a)}</td><td>{esc(m)}</td><td>{t}</td><td>{c}</td></tr>'
        for a, m, t, c in rows)
    domain = esc(domain)
    title_q = esc(title_q)

    CSS = ('<style>body{font-family:"Microsoft YaHei","WenQuanYi Micro Hei",sans-serif;'
           'font-size:10.5pt;line-height:1.5;margin:1.8cm;}'
           'h1{font-size:18pt;text-align:center;color:#1a237e;}'
           'h2{font-size:14pt;color:#1a237e;border-left:4px solid #1a237e;padding-left:8px;margin-top:14px;}'
           'h3{font-size:11.5pt;color:#283593;margin-top:10px;}'
           'table{border-collapse:collapse;width:100%;font-size:8.5pt;margin:6px 0;}'
           'th,td{border:1px solid #999;padding:4px 6px;} th{background:#e8eaf6;}'
           'pre{background:#f5f5f5;border:1px solid #ddd;padding:6px;font-size:7.5pt;'
           'white-space:pre-wrap;word-wrap:break-word;}'
           '.code-title{font-weight:bold;font-size:9pt;margin-top:10px;color:#c62828;}'
           '.meta{text-align:center;color:#555;font-size:10pt;} p{text-align:justify;}</style>')

    FRONT_HTML = f'''<html><head><meta charset="utf-8">{CSS}</head><body>
<h1>基于国产开源大模型的 AI Scientist 的研发与应用<br/>技术方案文档</h1>
<p class="meta">题目编号：XH-202619　|　发榜单位：浙江阿里巴巴云计算有限公司<br/>
基座模型：Qwen（千问）开源系列（Qwen-Max / Qwen-VL-Max），经阿里云百炼平台 API 调用<br/>
生成时间：2026-08-30　|　团队：__（请在前端填写）__　|　院校：__（请在前端填写）__</p>

<h2>一、研究问题与解决方法</h2>
<h3>1.1 传统科研模式的痛点</h3>
<p>传统科研高度依赖研究者的个人经验与文献积累。在面对海量数据、跨学科交叉和复杂系统时，人工研究往往效率低下、易陷入思维定式，假设的提出缺乏系统性，且难以在生成之初即保证<strong>可验证性</strong>与<strong>自洽性</strong>。尤其在“{title_q}”这类前沿科学问题上，暗物质、暗能量、额外维度等候选方向分散于粒子物理、天体物理与宇宙学文献中，人工梳理并生成可检验假设的成本极高。</p>

<h3>1.2 本系统的解决思路</h3>
<p>本系统基于国产开源大模型 <strong>Qwen（千问）</strong>，通过<strong>阿里云百炼平台</strong>调用模型 API，构建多智能体（Multi-Agent）“科研灵感流水线”，实现从“数据/文献输入”到“可验证科学假设输出”的智能闭环。整体推导链条为：</p>
<p><strong>①知识缺口识别 → ②文献事实提取 → ③逻辑驱动假设生成（归纳+演绎）→ ④研究设计与操作化 → ⑤实验规划 → ⑥数据分析与可视化 → ⑦结构化写作（12字段）→ ⑧评审/反思多轮迭代 + 人在回路。</strong></p>

<h3>1.3 对应赛题四大能力项</h3>
<table><tr><th>赛题能力项</th><th>本系统实现</th></tr>
<tr><td>（一）文献挖掘与事实提取</td><td>literature 智能体进行系统文献综述，提取核心概念、理论基础（≥3）与研究空白，输出真实文献引用，避免断章取义</td></tr>
<tr><td>（二）逻辑驱动的假设生成</td><td>hypothesis 智能体基于已知事实，利用归纳与演绎推理生成候选假设 H1–H5，并给出可验证性评分；design 智能体将其操作化为可证伪命题</td></tr>
<tr><td>（三）论证可行与多轮迭代</td><td>analysis 智能体给出可运行数据分析代码与稳健性检验（≥3种）；review 与 reflection 智能体评审/反思，其反馈回注 writing 实现多轮迭代</td></tr>
<tr><td>（四）智能体思辨与人在回路</td><td>设置 review（审稿）与 reflection（反思）双智能体构成“生成—评审—反思—迭代”思辨闭环；前端提供驳回重做(retry)、跳过(skip)、中止(abort)、重启步骤(restart-step)、重启项目(restart-project) 等人工介入能力</td></tr>
</table>

<h3>1.4 选题说明</h3>
<p>选题来自公开发布的 <strong>Science 125 前沿科学问题（2005年版）</strong>，领域为<strong>{domain}</strong>（自然科学方向），来源合规。系统围绕该问题链接 XENON、Planck、SDSS、LHC 等多维度实测数据，生成可验证假设（详见第三部分真实案例）。</p>

