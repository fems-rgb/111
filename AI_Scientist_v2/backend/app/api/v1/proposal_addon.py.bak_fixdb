def register_proposal_routes(router):
    from fastapi import Depends, HTTPException, Response
    from sqlalchemy.ext.asyncio import AsyncSession

    @router.get("/competition-proposal/{project_id}")
    def competition_proposal(project_id: int, db: AsyncSession = Depends(get_db)):
        pdf = generate_competition_proposal(project_id)
        if not pdf or not os.path.exists(pdf):
            raise HTTPException(500, "完整技术方案文档生成失败，请先确保流水线已完整运行")
        with open(pdf, "rb") as f:
            data = f.read()
        return Response(data, media_type="application/pdf",
                        headers={"Content-Disposition":
                                 f'attachment; filename="XH-202619_proposal_{project_id}.pdf"'})
    get_db = __import__('app.api.v1.export', fromlist=['get_db']).get_db
