    """真实结构: 从 meta 读 data_table, 调用 _auto_generate_charts + _build_wrapper。"""
    run_dir = os.path.join(OUTPUT_ROOT, str(run_id))
    charts_dir = os.path.join(run_dir, 'charts')
    os.makedirs(charts_dir, exist_ok=True)

    # 模拟 API 层: 把 meta 存在函数属性上
    meta_raw = getattr(run_experiment, '_last_meta', None) or '{}'
    try:
        meta = json.loads(meta_raw) if isinstance(meta_raw, str) else dict(meta_raw or {})
    except Exception:
        meta = {}

    charts_list = _auto_generate_charts(charts_dir, run_id)
    wrapper = _build_wrapper(code, run_dir, charts_dir, generate_video, data_table=data_table)
    run_py = os.path.join(run_dir, '_run.py')
