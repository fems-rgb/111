# ══════════════════════════════════════════════════════════════════
# 智研星枢 生产环境变量（deploy/.env）——复制 .env.example 为 .env 后填写
# 该文件同时被 docker compose 读取：${POSTGRES_PASSWORD} 插值 + 注入 app 容器
# ⚠️ .env 含密钥，绝不提交 git
# ══════════════════════════════════════════════════════════════════

# ---- 必填 ----
# 随机密钥：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# PostgreSQL 密码（字母数字，避免特殊字符需转义）
POSTGRES_PASSWORD=
# 通义千问（阿里云百炼 DashScope）
QWEN_API_KEY=

# ---- 应用 ----
APP_NAME=智研星枢
APP_VERSION=3.0.0
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 安全 ----
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=20
# 生产改为你的域名，如 ["https://zhixing.example.com"]
ALLOWED_ORIGINS=["*"]

# ---- 可扩展性（DATABASE_URL/REDIS_URL 由 compose 注入，勿在此写）----
GENERATION_MAX_CONCURRENCY=4
GENERATION_QUEUE_MAX=100
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# ---- 可观测性 ----
TRACE_RETENTION_DAYS=30
COST_ALERT_THRESHOLD_YUAN=100.0

# ---- 可选模型供应商（留空即不启用）----
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
