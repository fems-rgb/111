import { saveAs } from 'file-saver'

/**
 * 将 Markdown 内容导出为 Word (.doc) 文件
 * 使用 HTML 格式包装，Word 可原生打开
 */
export function exportToWord(markdownContent, title = '研究报告') {
  if (!markdownContent) {
    console.error('[exportToWord] markdownContent 为空')
    return
  }

  // 简单的 Markdown → HTML 转换
  let html = markdownContent
    .replace(/^### (.+)$/gm, '<h3></h3>')
    .replace(/^## (.+)$/gm, '<h2></h2>')
    .replace(/^# (.+)$/gm, '<h1></h1>')
    .replace(/\*\*(.+?)\*\*/g, '<strong></strong>')
    .replace(/\*(.+?)\*/g, '<em></em>')
    .replace(/^\| (.+) \|$/gm, (match) => {
      const cells = match.split('|').filter(c => c.trim())
      const isSeparator = cells.some(c => /^[\s\-:]+$/.test(c))
      if (isSeparator) return ''
      const tds = cells.map(c => '<td style="border:1px solid #ddd;padding:4px 8px;">' + c.trim() + '</td>').join('')
      return '<tr>' + tds + '</tr>'
    })
    .replace(/^- (.+)$/gm, '<li></li>')
    .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
    .replace(/\n{2,}/g, '<br/><br/>')
    .replace(/\n/g, '<br/>')

  const fullHtml = '<?xml version="1.0" encoding="UTF-8"?>\n' +
'<html xmlns:o="urn:schemas-microsoft-com:office:office"\n' +
'      xmlns:w="urn:schemas-microsoft-com:office:word"\n' +
'      xmlns="http://www.w3.org/TR/REC-html40">\n' +
'<head>\n' +
'<meta charset="utf-8"/>\n' +
'<title>' + title + '</title>\n' +
'<style>\n' +
'  body { font-family: "SimSun", "Noto Sans SC", sans-serif; line-height: 1.8; font-size: 12pt; margin: 2cm; }\n' +
'  h1 { font-size: 18pt; color: #1a237e; border-bottom: 2px solid #1a237e; padding-bottom: 6px; }\n' +
'  h2 { font-size: 15pt; color: #283593; border-bottom: 1px solid #ccc; }\n' +
'  h3 { font-size: 13pt; color: #303f9f; }\n' +
'  table { border-collapse: collapse; width: 100%; margin: 10px 0; font-size: 10pt; }\n' +
'  td, th { border: 1px solid #ddd; padding: 4px 8px; }\n' +
'  ul { margin-left: 20px; }\n' +
'</style>\n' +
'</head>\n' +
'<body>' + html + '</body>\n' +
'</html>'

  const blob = new Blob([fullHtml], {
    type: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document;charset=utf-8'
  })
  saveAs(blob, title + '.doc')
}
