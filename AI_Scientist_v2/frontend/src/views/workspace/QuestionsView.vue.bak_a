<template>
  <div class="p-6 max-w-7xl mx-auto space-y-6">
    <!-- ═══ 顶部标题栏 ═══ -->
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div>
        <h1 class="text-2xl font-bold text-surface-800">🔬 科学问题题库</h1>
        <p class="text-sm text-surface-500 mt-1">Science 125 · 探索前沿科学问题，AI 辅助生成研究文档</p>
      </div>
      <div class="flex gap-2">
        <button @click="showAddDialog = true"
                class="px-4 py-2 rounded-lg bg-green-600 text-white hover:bg-green-700 transition-colors text-sm">
          ✏️ 添加题目
        </button>
        <button @click="importScience125" :disabled="importing125"
                class="px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50 transition-colors text-sm">
          {{ importing125 ? '导入中...' : '📥 导入 Science 125' }}
        </button>
        <button @click="switchTab(activeTab === 'questions' ? 'tasks' : 'questions')"
                class="px-4 py-2 rounded-lg bg-primary-600 text-white hover:bg-primary-700 transition-colors text-sm">
          {{ activeTab === 'questions' ? '📋 我的任务' : '🔍 返回题库' }}
        </button>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- TAB: 题库列表 -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div v-if="activeTab === 'questions'" class="space-y-4">

      <!-- 筛选栏 -->
      <div class="flex gap-3 flex-wrap items-center">
        <select v-model="filterCategory" @change="loadQuestions(1)"
                class="border border-surface-200 rounded-lg px-3 py-2 text-sm bg-white">
          <option value="">全部分类</option>
          <option v-for="c in categories" :key="c.category" :value="c.category">
            {{ c.category }} ({{ c.count }})
          </option>
        </select>
        <select v-model="filterDifficulty" @change="loadQuestions(1)"
                class="border border-surface-200 rounded-lg px-3 py-2 text-sm bg-white">
          <option value="">全部难度</option>
          <option value="easy">简单</option>
          <option value="medium">中等</option>
          <option value="hard">困难</option>
        </select>
        <input v-model="keyword" @keyup.enter="loadQuestions(1)" placeholder="搜索题目标题 / 描述 / 关键词..."
               class="border border-surface-200 rounded-lg px-3 py-2 text-sm flex-1 min-w-[200px]" />
        <button @click="loadQuestions(1)" class="px-4 py-2 rounded-lg bg-surface-100 hover:bg-surface-200 text-sm transition-colors">
          🔍 搜索
        </button>
      </div>

      <!-- 批量操作栏 -->
      <div v-if="questions.length > 0" class="flex items-center gap-3 flex-wrap bg-blue-50 border border-blue-200 rounded-lg px-4 py-2">
        <label class="flex items-center gap-2 text-sm cursor-pointer">
          <input type="checkbox" :checked="isAllSelected" :indeterminate="isPartialSelected"
                 @change="toggleSelectAll" class="w-4 h-4 rounded" />
          <span class="font-medium text-blue-700">全选</span>
        </label>
        <span class="text-sm text-blue-600">已选 {{ selectedIds.size }} / {{ questions.length }}</span>
        <div class="flex-1"></div>
        <button @click="openBatchGenerateDialog" :disabled="selectedIds.size === 0"
                class="px-3 py-1.5 rounded-lg bg-accent-600 text-white hover:bg-accent-700 disabled:opacity-40 transition-colors text-sm">
          🚀 批量生成 ({{ selectedIds.size }})
        </button>
              <button v-if="selectedIds.length > 0" @click="handleBatchDelete"
                class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-red-500 hover:bg-red-600 transition-all">
                🗑️ 批量删除 ({{ selectedIds.length }})
              </button>
              <button @click="handleDeleteAll"
                class="px-4 py-2 rounded-lg text-sm font-medium text-red-600 border border-red-300 hover:bg-red-50 transition-all">
                ⚠️ 清空全部
              </button>
      </div>

      <!-- 题目列表 -->
      <div v-if="loading" class="text-center py-12 text-surface-400">加载中...</div>
      <div v-else-if="questions.length === 0" class="text-center py-12 text-surface-400">暂无题目</div>
      <div v-else class="grid gap-3">
        <div v-for="q in questions" :key="q.question_id"
             class="bg-white border rounded-xl p-4 hover:shadow-md transition-all flex items-start gap-3"
             :class="selectedIds.has(q.question_id) ? 'border-blue-400 bg-blue-50/30' : 'border-surface-200'">
          <!-- Checkbox -->
          <input type="checkbox" :checked="selectedIds.has(q.question_id)"
                 @change="toggleSelect(q.question_id)"
                 class="mt-1 w-4 h-4 rounded shrink-0 cursor-pointer" />
          <!-- 内容（可点击查看详情） -->
          <div class="flex-1 min-w-0 cursor-pointer" @click="openDetailDialog(q)">
            <div class="flex items-center gap-2 mb-1 flex-wrap">
              <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-primary-100 text-primary-700">{{ q.category }}</span>
              <span class="px-2 py-0.5 rounded-full text-xs font-medium" :class="difficultyClass(q.difficulty)">
                {{ difficultyLabel(q.difficulty) }}
              </span>
              <span v-if="q.source === 'user_custom'" class="px-2 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-700">自定义</span>
              <span class="text-xs text-surface-400 ml-auto">#{{ q.question_id }}</span>
            </div>
            <h3 class="font-semibold text-surface-800">{{ q.title }}</h3>
            <p v-if="q.title_en" class="text-xs text-surface-400 mt-0.5">{{ q.title_en }}</p>
            <p v-if="q.description" class="text-sm text-surface-500 mt-1.5 line-clamp-2">{{ q.description }}</p>
            <div v-if="q.keywords?.length" class="flex flex-wrap gap-1 mt-2">
              <span v-for="kw in q.keywords.slice(0, 6)" :key="kw"
                    class="px-1.5 py-0.5 rounded text-xs bg-surface-100 text-surface-500">#{{ kw }}</span>
            </div>
          </div>
          <!-- 操作按钮 -->
          <div class="shrink-0 flex flex-col gap-2">
            <button @click.stop="openGenerateDialog(q)"
                    class="px-3 py-1.5 rounded-lg bg-accent-600 text-white hover:bg-accent-700 transition-colors text-xs whitespace-nowrap">
              🚀 生成
            </button>
            <button @click.stop="openDetailDialog(q)"
                    class="px-3 py-1.5 rounded-lg bg-surface-100 hover:bg-surface-200 transition-colors text-xs whitespace-nowrap">
              📄 详情
            </button>
          </div>
        </div>
      </div>

      <!-- 分页 -->
      <div v-if="totalPages > 1" class="flex justify-center gap-2 pt-2">
        <button @click="loadQuestions(page - 1)" :disabled="page <= 1"
                class="px-3 py-1.5 rounded border text-sm disabled:opacity-40 hover:bg-surface-50">上一页</button>
        <span class="px-3 py-1.5 text-sm text-surface-500">{{ page }} / {{ totalPages }}（共 {{ total }} 题）</span>
        <button @click="loadQuestions(page + 1)" :disabled="page >= totalPages"
                class="px-3 py-1.5 rounded border text-sm disabled:opacity-40 hover:bg-surface-50">下一页</button>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- TAB: 我的任务 -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div v-if="activeTab === 'tasks'" class="space-y-4">
      <div class="flex gap-2 items-center">
        <select v-model="taskStatusFilter" @change="loadMyTasks"
                class="border border-surface-200 rounded-lg px-3 py-2 text-sm bg-white">
          <option value="">全部状态</option>
          <option value="pending">等待中</option>
          <option value="running">运行中</option>
          <option value="completed">已完成</option>
          <option value="failed">失败</option>
        </select>
        <button @click="loadMyTasks" class="px-3 py-2 rounded-lg bg-surface-100 hover:bg-surface-200 text-sm">🔄 刷新</button>
      </div>

      <!-- 任务批量操作栏 -->
      <div v-if="myTasks.length > 0" class="flex items-center gap-3 flex-wrap bg-red-50 border border-red-200 rounded-lg px-4 py-2">
        <label class="flex items-center gap-2 text-sm cursor-pointer">
          <input type="checkbox" :checked="isAllTasksSelected" :indeterminate="isPartialTasksSelected"
                 @change="toggleSelectAllTasks" class="w-4 h-4 rounded" />
          <span class="font-medium text-red-700">全选</span>
        </label>
        <span class="text-sm text-red-600">已选 {{ selectedTaskIds.size }} / {{ myTasks.length }}</span>
        <div class="flex-1"></div>
        <button @click="confirmBatchDeleteTasks" :disabled="selectedTaskIds.size === 0"
                class="px-3 py-1.5 rounded-lg bg-red-600 text-white hover:bg-red-700 disabled:opacity-40 transition-colors text-sm">
          🗑️ 批量删除 ({{ selectedTaskIds.size }})
        </button>
      </div>

      <div v-if="tasksLoading" class="text-center py-12 text-surface-400">加载中...</div>
      <div v-else-if="myTasks.length === 0" class="text-center py-12 text-surface-400">暂无任务记录</div>
      <div v-else class="bg-white border border-surface-200 rounded-xl overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-surface-50 border-b border-surface-200">
            <tr>
              <th class="px-4 py-3 w-10"><input type="checkbox" :checked="isAllTasksSelected" :indeterminate="isPartialTasksSelected" @change="toggleSelectAllTasks" class="w-4 h-4 rounded" /></th>
              <th class="text-left px-4 py-3 font-medium text-surface-600">任务ID</th>
              <th class="text-left px-4 py-3 font-medium text-surface-600">题目</th>
              <th class="text-left px-4 py-3 font-medium text-surface-600">状态</th>
              <th class="text-left px-4 py-3 font-medium text-surface-600">进度</th>

              <th class="text-left px-4 py-3 font-medium text-surface-600">版本</th>
              <th class="text-left px-4 py-3 font-medium text-surface-600">创建时间</th>
              <th class="text-left px-4 py-3 font-medium text-surface-600">操作</th>
            </tr>
          </thead>
          <tbody>
            <tr v-for="t in myTasks" :key="t.task_id" class="border-b border-surface-100 hover:bg-surface-50">
              <td class="px-4 py-3"><input type="checkbox" :checked="selectedTaskIds.has(t.task_id)" @change="toggleSelectTask(t.task_id)" class="w-4 h-4 rounded cursor-pointer" /></td>
              <td class="px-4 py-3 text-surface-500">#{{ t.task_id }}</td>
              <td class="px-4 py-3 max-w-[200px] truncate">{{ t.question_title || ('题目#' + t.question_id) }}</td>
              <td class="px-4 py-3">
                <span :class="statusClass(t.status)" class="px-2 py-0.5 rounded-full text-xs font-medium">
                  {{ statusLabel(t.status) }}
                </span>
              </td>
              <td class="px-4 py-3">
                <div v-if="t.status === 'running'" class="flex items-center gap-2">
                  <div class="w-20">
                    <div class="h-2 bg-surface-200 rounded-full overflow-hidden">
                      <div class="h-full bg-blue-500 transition-all duration-500" :style="{ width: (t.progress || 0) + '%' }"></div>
                    </div>
                    <span class="text-xs text-surface-400">{{ t.progress || 0 }}%</span>
                  </div>
                  <router-link v-if="t.result?.project_id" :to="'/workspace/project/' + t.result.project_id"
                    class="text-xs text-primary-600 hover:underline whitespace-nowrap"> 工作台</router-link>
                </div>
                <span v-else-if="t.status === 'completed'" class="text-green-600 text-xs">✓ 100%</span>
                <span v-else-if="t.status === 'failed'" class="text-red-500 text-xs">✗</span>
                <span v-else class="text-surface-400 text-xs">-</span>
              </td>
              <td class="px-4 py-3">v{{ t.version }}</td>
              <td class="px-4 py-3 text-surface-500 text-xs">{{ formatDate(t.created_at) }}</td>
              <td class="px-4 py-3">
                <div class="flex gap-2">
                  <button @click="viewTaskDetail(t.task_id)" class="text-primary-600 hover:underline text-xs">详情</button>
                  <button v-if="t.result?.project_id" @click="goToProject(t.result.project_id)"
                          class="text-orange-600 hover:underline text-xs">🔬 查看项目</button>
                  <button v-if="t.status === 'completed'" @click="viewDocument(t.task_id)"
                          class="text-green-600 hover:underline text-xs">📄 查看文档</button>
                  <button v-if="t.status === 'failed'" @click="handleRetryTask(t.task_id)"
                          :disabled="retryingTaskId === t.task_id"
                          class="text-amber-600 hover:underline text-xs disabled:opacity-50">{{ retryingTaskId === t.task_id ? '⏳ 重试中...' : '🔄 重试' }}</button>
                  <button @click="confirmDeleteTask(t.task_id)"
                          class="text-red-500 hover:underline text-xs">🗑️ 删除</button>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 弹窗: 题目详情 -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Teleport to="body">
      <div v-if="detailData" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="detailData = null">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-3xl p-0 max-h-[90vh] overflow-hidden flex flex-col">
          
          <!-- 顶部标题栏 -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-surface-100 bg-gradient-to-r from-primary-50 to-blue-50">
            <div class="flex items-center gap-3">
              <span class="text-2xl">📋</span>
              <div>
                <h2 class="text-lg font-bold text-surface-800">题目详情 #{{ detailData.question_id }}</h2>
                <p class="text-xs text-surface-400">创建于 {{ formatDate(detailData.created_at) }}</p>
              </div>
            </div>
            <button @click="detailData = null" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-200 text-surface-400 hover:text-surface-600 transition-colors">✕</button>
          </div>
          
          <!-- 可滚动内容区 -->
          <div class="flex-1 overflow-y-auto px-6 py-4 space-y-5">
            
            <!-- 标签行 -->
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-primary-100 text-primary-700">{{ detailData.category }}</span>
              <span class="px-2.5 py-1 rounded-full text-xs font-medium" :class="difficultyClass(detailData.difficulty)">
                {{ difficultyLabel(detailData.difficulty) }}
              </span>
              <span v-if="detailData.source" class="px-2.5 py-1 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">来源: {{ detailData.source }}</span>
              <span v-if="detailData.task_history?.length" class="px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-200">
                📝 {{ detailData.task_history.length }} 次生成
              </span>
            </div>
            
            <!-- 题目标题 -->
            <div>
              <h3 class="text-xl font-bold text-surface-800 leading-relaxed">{{ detailData.title }}</h3>
              <p v-if="detailData.title_en" class="text-sm text-surface-400 italic mt-1">{{ detailData.title_en }}</p>
            </div>
            
            <!-- 详细描述 -->
            <div v-if="detailData.description" class="p-4 bg-surface-50 rounded-xl border border-surface-100">
              <h4 class="text-xs font-semibold text-surface-500 uppercase tracking-wide mb-2">📖 问题描述</h4>
              <p class="text-sm text-surface-700 whitespace-pre-wrap leading-relaxed">{{ detailData.description }}</p>
            </div>
            
            <!-- 关键词 -->
            <div v-if="detailData.keywords?.length">
              <h4 class="text-xs font-semibold text-surface-500 uppercase tracking-wide mb-2">🏷️ 关键词</h4>
              <div class="flex flex-wrap gap-2">
                <span v-for="kw in detailData.keywords" :key="kw"
                      class="px-3 py-1 rounded-full text-xs bg-blue-50 text-blue-600 border border-blue-200 hover:bg-blue-100 transition-colors cursor-default">#{{ kw }}</span>
              </div>
            </div>
            
            <!-- 元数据信息 -->
            <div class="grid grid-cols-2 gap-3">
              <div class="p-3 bg-surface-50 rounded-xl border border-surface-100">
                <p class="text-xs text-surface-400">题目 ID</p>
                <p class="text-sm font-mono text-surface-700 mt-0.5">{{ detailData.question_id }}</p>
              </div>
              <div class="p-3 bg-surface-50 rounded-xl border border-surface-100">
                <p class="text-xs text-surface-400">更新时间</p>
                <p class="text-sm text-surface-700 mt-0.5">{{ formatDate(detailData.updated_at || detailData.created_at) }}</p>
              </div>
            </div>
            
            <!-- 该题目的任务历史 -->
            <div class="pt-2">
              <h4 class="text-sm font-semibold text-surface-600 mb-3 flex items-center gap-2">
                📝 生成历史
                <span v-if="detailData.task_history?.length" class="text-xs font-normal text-surface-400">({{ detailData.task_history.length }})</span>
              </h4>
              
              <div v-if="detailData.task_history?.length" class="space-y-2">
                <div v-for="(th, idx) in detailData.task_history" :key="th.task_id"
                     class="relative pl-6 pb-4 last:pb-0">
                  <!-- 时间线 -->
                  <div class="absolute left-2 top-1.5 w-2.5 h-2.5 rounded-full border-2"
                       :class="th.status === 'completed' ? 'bg-green-500 border-green-500' : th.status === 'failed' ? 'bg-red-500 border-red-500' : 'bg-blue-500 border-blue-500 animate-pulse'"></div>
                  <div v-if="idx < detailData.task_history.length - 1" class="absolute left-[12px] top-4 w-0.5 h-full bg-surface-200"></div>
                  
                  <div class="flex items-center justify-between p-3 bg-surface-50 rounded-xl border border-surface-100 hover:border-primary-200 transition-colors">
                    <div class="space-y-1">
                      <div class="flex items-center gap-2">
                        <span :class="statusClass(th.status)" class="px-2 py-0.5 rounded-full text-xs font-medium">{{ statusLabel(th.status) }}</span>
                        <span class="text-xs text-surface-400">v{{ th.version }}</span>
                        <span class="text-xs text-surface-400">{{ formatDate(th.created_at) }}</span>
                      </div>
                      <p v-if="th.pipeline_name" class="text-xs text-surface-500">流水线: {{ th.pipeline_name }}</p>
                    </div>
                    <div class="flex gap-2">
                      <button @click="detailData = null; viewTaskDetail(th.task_id); switchTab('tasks')"
                              class="px-2.5 py-1 rounded-lg text-xs text-primary-600 hover:bg-primary-50 border border-primary-200 transition-colors">查看详情</button>
                      <button v-if="th.status === 'completed'" @click="detailData = null; viewDocument(th.task_id)"
                              class="px-2.5 py-1 rounded-lg text-xs text-green-600 hover:bg-green-50 border border-green-200 transition-colors">📄 文档</button>
                    </div>
                  </div>
                </div>
              </div>
              
              <div v-else class="p-6 bg-surface-50 rounded-xl border border-dashed border-surface-200 text-center">
                <p class="text-surface-400 text-sm">暂无生成记录</p>
                <p class="text-surface-300 text-xs mt-1">点击下方按钮开始生成研究文档</p>
              </div>
            </div>
          </div>
          
          <!-- 底部操作栏 -->
          <div class="flex items-center justify-between px-6 py-4 border-t border-surface-100 bg-surface-50">
            <button @click="detailData = null" class="px-4 py-2 rounded-lg text-sm text-surface-600 hover:bg-surface-200 transition-colors">
              关闭
            </button>
            <button @click="detailData = null; openGenerateDialogFromDetail()"
                    class="px-5 py-2.5 rounded-lg bg-accent-600 text-white hover:bg-accent-700 text-sm font-medium shadow-sm hover:shadow-md transition-all">
              🚀 生成文档
            </button>
          </div>
        </div>
      </div>
    </Teleport>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 弹窗: 生成文档（单个） -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Teleport to="body">
      <div v-if="showGenDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="showGenDialog = false">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg p-6 space-y-4">
          <h2 class="text-lg font-bold text-surface-800">🚀 生成研究文档</h2>
          <p class="text-sm text-surface-600">题目：<strong>{{ genTarget?.title }}</strong></p>

          <!-- 生成方式选择 -->
          <div class="space-y-2">
            <label class="text-sm font-medium text-surface-600">生成方式</label>
            <div class="flex gap-3">
              <label class="flex items-center gap-2 p-3 border rounded-lg cursor-pointer flex-1 transition-colors"
                     :class="genMode === 'direct' ? 'border-accent-400 bg-accent-50' : 'border-surface-200 hover:bg-surface-50'">
                <input type="radio" v-model="genMode" value="direct" class="sr-only" />
                <div>
                  <div class="text-sm font-medium">⚡ 直接生成</div>
                  <div class="text-xs text-surface-400">快速生成文档</div>
                </div>
              </label>
              <label class="flex items-center gap-2 p-3 border rounded-lg cursor-pointer flex-1 transition-colors"
                     :class="genMode === 'pipeline' ? 'border-accent-400 bg-accent-50' : 'border-surface-200 hover:bg-surface-50'">
                <input type="radio" v-model="genMode" value="pipeline" class="sr-only" />
                <div>
                  <div class="text-sm font-medium">🔗 流水线生成</div>
                  <div class="text-xs text-surface-400">通过 Agent 流水线</div>
                </div>
              </label>
            </div>
          </div>

          <!-- 流水线选择 -->
          <div v-if="genMode === 'pipeline'" class="space-y-1">
            <label class="text-sm font-medium text-surface-600">选择流水线</label>
            <select v-model="genPipelineId" class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm bg-white">
              <option value="">-- 请选择 --</option>
              <option v-for="p in pipelines" :key="p.id" :value="p.id">{{ p.name }}</option>
            </select>
          </div>

          <textarea v-model="genPrompt" rows="3" placeholder="可选：输入自定义提示词，引导 AI 生成方向..."
                    class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm resize-none focus:ring-2 focus:ring-primary-300 outline-none"></textarea>

          <div class="flex justify-end gap-3">
            <button @click="showGenDialog = false" class="px-4 py-2 rounded-lg text-sm text-surface-500 hover:bg-surface-100">取消</button>
            <button @click="submitSingleGenerate" :disabled="generating || (genMode === 'pipeline' && !genPipelineId)"
                    class="px-4 py-2 rounded-lg text-sm bg-accent-600 text-white hover:bg-accent-700 disabled:opacity-50 transition-colors">
              {{ generating ? '提交中...' : '确认生成' }}
            </button>
          </div>
        </div>
      </div>
    </Teleport>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 弹窗: 批量生成 -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Teleport to="body">
      <div v-if="showBatchDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="showBatchDialog = false">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg p-6 space-y-4">
          <h2 class="text-lg font-bold text-surface-800">🚀 批量生成文档</h2>
          <p class="text-sm text-surface-600">已选择 <strong>{{ selectedIds.size }}</strong> 个题目</p>

          <div class="space-y-2">
            <label class="text-sm font-medium text-surface-600">生成方式</label>
            <div class="flex gap-3">
              <label class="flex items-center gap-2 p-3 border rounded-lg cursor-pointer flex-1 transition-colors"
                     :class="batchMode === 'direct' ? 'border-accent-400 bg-accent-50' : 'border-surface-200 hover:bg-surface-50'">
                <input type="radio" v-model="batchMode" value="direct" class="sr-only" />
                <div class="text-sm font-medium">⚡ 直接生成</div>
              </label>
              <label class="flex items-center gap-2 p-3 border rounded-lg cursor-pointer flex-1 transition-colors"
                     :class="batchMode === 'pipeline' ? 'border-accent-400 bg-accent-50' : 'border-surface-200 hover:bg-surface-50'">
                <input type="radio" v-model="batchMode" value="pipeline" class="sr-only" />
                <div class="text-sm font-medium">🔗 流水线</div>
              </label>
            </div>
          </div>

          <div v-if="batchMode === 'pipeline'" class="space-y-1">
            <select v-model="batchPipelineId" class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm bg-white">
              <option value="">-- 选择流水线 --</option>
              <option v-for="p in pipelines" :key="p.id" :value="p.id">{{ p.name }}</option>
            </select>
          </div>

          <textarea v-model="batchPrompt" rows="2" placeholder="可选：统一自定义提示词..."
                    class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm resize-none focus:ring-2 focus:ring-primary-300 outline-none"></textarea>

          <div class="flex justify-end gap-3">
            <button @click="showBatchDialog = false" class="px-4 py-2 rounded-lg text-sm text-surface-500 hover:bg-surface-100">取消</button>
            <button @click="submitBatchGenerate" :disabled="batchGenerating || (batchMode === 'pipeline' && !batchPipelineId)"
                    class="px-4 py-2 rounded-lg text-sm bg-accent-600 text-white hover:bg-accent-700 disabled:opacity-50 transition-colors">
              {{ batchGenerating ? '提交中...' : `批量生成 (${selectedIds.size})` }}
            </button>
          </div>
        </div>
      </div>
    </Teleport>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 弹窗: 添加自定义题目 -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Teleport to="body">
      <div v-if="showAddDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="showAddDialog = false">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg p-6 space-y-4 max-h-[85vh] overflow-y-auto">
          <h2 class="text-lg font-bold text-surface-800">✏️ 添加自定义题目</h2>
          <div class="space-y-3">
            <div>
              <label class="text-sm font-medium text-surface-600 block mb-1">题目标题 *</label>
              <input v-model="addForm.title" placeholder="输入科学问题标题..."
                     class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary-300 outline-none" />
            </div>
            <div>
              <label class="text-sm font-medium text-surface-600 block mb-1">英文标题</label>
              <input v-model="addForm.title_en" placeholder="English title (optional)"
                     class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary-300 outline-none" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="text-sm font-medium text-surface-600 block mb-1">分类 *</label>
                <input v-model="addForm.category" placeholder="如：宇宙学、生命科学..."
                       class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary-300 outline-none" />
              </div>
              <div>
                <label class="text-sm font-medium text-surface-600 block mb-1">难度</label>
                <select v-model="addForm.difficulty" class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm bg-white">
                  <option value="easy">简单</option>
                  <option value="medium">中等</option>
                  <option value="hard">困难</option>
                </select>
              </div>
            </div>
            <div>
              <label class="text-sm font-medium text-surface-600 block mb-1">详细描述</label>
              <textarea v-model="addForm.description" rows="3" placeholder="描述这个科学问题的背景和意义..."
                        class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm resize-none focus:ring-2 focus:ring-primary-300 outline-none"></textarea>
            </div>
            <div>
              <label class="text-sm font-medium text-surface-600 block mb-1">关键词（逗号分隔）</label>
              <input v-model="addForm.keywordsStr" placeholder="如：暗物质, 宇宙膨胀, 引力波"
                     class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary-300 outline-none" />
            </div>
          </div>
          <div class="flex justify-end gap-3 pt-2">
            <button @click="showAddDialog = false" class="px-4 py-2 rounded-lg text-sm text-surface-500 hover:bg-surface-100">取消</button>
            <button @click="submitAddQuestion" :disabled="addingQuestion || !addForm.title.trim() || !addForm.category.trim()"
                    class="px-4 py-2 rounded-lg text-sm bg-green-600 text-white hover:bg-green-700 disabled:opacity-50 transition-colors">
              {{ addingQuestion ? '添加中...' : '确认添加' }}
            </button>
          </div>
