    <!-- ═══ Toast 消息 ═══ -->
    <Teleport to="body">
      <Transition name="toast">
        <div v-if="toastMsg" class="fixed top-6 right-6 z-[100] px-5 py-3 rounded-xl shadow-lg text-sm font-medium"
             :class="toastType === 'success' ? 'bg-green-600 text-white' : toastType === 'error' ? 'bg-red-600 text-white' : 'bg-blue-600 text-white'">
          {{ toastMsg }}
        </div>
      </Transition>
    </Teleport>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 覆盖层: 生成进度跟踪 -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Teleport to="body">
      <!-- 生成进度: 右下角可收起小窗 (展开态) -->
      <div v-if="activeTask && !appStore.genMinimized" class="fixed z-[60] w-80 animate-fade-in"
           :style="{ left: genDialogPos.x + 'px', top: genDialogPos.y + 'px' }">
        <div class="relative bg-white rounded-2xl shadow-2xl border border-surface-200 p-5 space-y-4 text-center"
             style="cursor: move;"
             @mousedown="onDragStart">
            <!-- 收起按钮 -->
            <button @click="appStore.genMinimized = true"
                    class="absolute top-2 right-2 w-7 h-7 flex items-center justify-center rounded-full bg-surface-100 hover:bg-surface-200 text-surface-500 hover:text-surface-700 transition-colors z-10 text-sm"
                    title="收起(任务继续在后台运行)">−</button>
          <template v-if="activeTask && (activeTask.status === 'running' || activeTask.status === 'pending')">

            <div class="relative w-20 h-20 mx-auto">
              <svg class="animate-spin w-full h-full text-primary-200" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="8" />
              </svg>
              <svg class="absolute inset-0 animate-spin-slow w-full h-full text-primary-600" viewBox="0 0 100 100" style="animation-duration: 3s;">
                <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="8"
                        :stroke-dasharray="(283 * ((activeTask && activeTask.progress) || 0) / 100) + ' ' + (283 - 283 * ((activeTask && activeTask.progress) || 0) / 100)" stroke-linecap="round" style="transition: stroke-dasharray 0.5s ease" />
              </svg>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-lg font-bold text-primary-700">{{ ((activeTask && activeTask.progress) || 0) }}%</span>
              </div>
            </div>
            <h3 class="text-xl font-bold text-surface-800">🚀 正在生成研究文档</h3>
            <p v-if="(activeTask && (activeTask.question_title || activeTask.title))" class="text-sm text-surface-500 truncate px-4">{{ (activeTask && (activeTask.question_title || activeTask.title)) }}</p>
            <div v-if="((activeTask && activeTask.progress) || 0) > 0" class="w-full bg-surface-100 rounded-full h-3 overflow-hidden">
              <div class="h-full bg-gradient-to-r from-primary-500 to-accent-500 transition-all duration-700 ease-out rounded-full"
                   :style="{ width: ((activeTask && activeTask.progress) || 0) + '%' }"></div>
            </div>
            <p class="text-xs text-surface-400">{{ ((activeTask && activeTask.progress) || 0) > 0 ? 'AI 正在分析题目并撰写报告，请稍候...' : '🚀 任务已提交，正在初始化流水线...' }}</p>
          </template>

          <!-- 完成 -->
          <template v-else-if="activeTask && activeTask.status === 'completed'">
            <div class="w-20 h-20 mx-auto bg-green-100 rounded-full flex items-center justify-center">
              <svg class="w-10 h-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-green-700">✅ 文档生成完成！</h3>
            <p v-if="(activeTask && (activeTask.question_title || activeTask.title))" class="text-sm text-surface-500 truncate px-4">{{ (activeTask && (activeTask.question_title || activeTask.title)) }}</p>
            <div class="flex gap-3 justify-center pt-2">
              <button @click="viewDocument(activeTask!.task_id); closeGenProgress()"
                      class="px-5 py-2.5 rounded-xl text-sm font-medium bg-green-600 text-white hover:bg-green-700 transition-colors shadow-lg shadow-green-200">
                📄 查看文档
              </button>
              <button @click="viewTaskDetail(activeTask!.task_id); closeGenProgress()"
                      class="px-5 py-2.5 rounded-xl text-sm font-medium bg-surface-100 text-surface-700 hover:bg-surface-200 transition-colors">
                📋 任务详情
              </button>
            </div>
            <button @click="closeGenProgress" class="text-xs text-surface-400 hover:text-surface-600 mt-2">关闭</button>
          </template>

          <!-- 失败 -->
          <template v-else-if="activeTask && activeTask.status === 'failed'">
            <div class="w-20 h-20 mx-auto bg-red-100 rounded-full flex items-center justify-center">
              <svg class="w-10 h-10 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-red-700">❌ 生成失败</h3>
            <p class="text-sm text-surface-500">请查看任务详情了解错误原因</p>
            <div class="flex gap-3 justify-center pt-2">
              <button @click="handleRetryTask(activeTask!.task_id)"
                      :disabled="retryingTaskId === activeTask?.task_id"
                      class="px-5 py-2.5 rounded-xl text-sm font-medium bg-amber-500 text-white hover:bg-amber-600 disabled:opacity-50 transition-colors shadow-lg shadow-amber-200">
                {{ retryingTaskId === activeTask?.task_id ? '⏳ 重试中...' : '🔄 重试生成' }}
              </button>
              <button @click="viewTaskDetail(activeTask!.task_id); closeGenProgress()"
                      class="px-5 py-2.5 rounded-xl text-sm font-medium bg-red-600 text-white hover:bg-red-700 transition-colors">
                🔍 查看错误详情
              </button>
              <button @click="closeGenProgress"
                      class="px-5 py-2.5 rounded-xl text-sm font-medium bg-surface-100 text-surface-700 hover:bg-surface-200 transition-colors">
                返回任务列表
              </button>
            </div>
          </template>
        </div>
      </div>
    </Teleport>
  </div>

      <!-- 收起态: 底部小条 -->
      <div v-if="activeTask && appStore.genMinimized"
           class="fixed z-[60] w-72 bg-white rounded-xl shadow-lg border border-surface-200 px-4 py-3 flex items-center gap-3 hover:shadow-xl transition-shadow animate-fade-in"
           :style="{ left: (genDialogPos.x + 200) + 'px', top: genDialogPos.y + 'px', cursor: 'move' }"
           @mousedown="onDragStart"
           @click="appStore.genMinimized = false">
        <svg class="animate-spin w-5 h-5 text-primary-600 flex-shrink-0" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="10"
                  :stroke-dasharray="(283 * ((activeTask && activeTask.progress) || 0) / 100) + ' ' + (283 - 283 * ((activeTask && activeTask.progress) || 0) / 100)" stroke-linecap="round" />
        </svg>
        <div class="flex-1 min-w-0">
          <p class="text-xs font-semibold text-surface-700 truncate">{{ (activeTask && (activeTask.question_title || activeTask.title)) || '生成中...' }}</p>
          <p class="text-[10px] text-surface-400">{{ ((activeTask && activeTask.progress) || 0) }}% · 点击展开</p>
        </div>
      </div>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted, watch } from 'vue'

// [fix26] 跨视图删除事件总线（QuestionsView 发射，DashboardView 监听）
import {
  getQuestions, getQuestionDetail, getCategories, createQuestion,
  generateQuestionDoc, batchGenerateDocs,
  getTaskStatus, getTaskDocument, submitFeedback, getMyTasks, deleteTask, batchDeleteTasks, batchImportQuestions,
  retryTask,
  type QuestionItem, type QuestionDetail, type CategoryStat,
  type TaskStatus, type MyTaskItem, type DocumentContent, batchDeleteQuestions, deleteAllQuestions } from '@/api/modules/questions'
import { automationApi, type Pipeline } from '@/api/modules/automation'
import { useProjectStore } from '@/stores/project'
import { useAppStore } from '@/stores/app'
import { SCIENCE_125_DATA } from '@/data/science125'

// ─── Toast ───
const toastMsg = ref('')
const toastType = ref<'success' | 'error' | 'info'>('info')
let toastTimer: ReturnType<typeof setTimeout> | null = null

function showToast(msg: string, type: 'success' | 'error' | 'info' = 'info', duration = 3000) {
  if (toastTimer) clearTimeout(toastTimer)
  toastMsg.value = msg
  toastType.value = type
  toastTimer = setTimeout(() => { toastMsg.value = '' }, duration)
}

// ─── 生成进度跟踪（已提升到 appStore 全局管理） ───
const appStore = useAppStore()
function closeGenProgress() {
  appStore.closeGenProgress()
  loadMyTasks()
}

// ─── 任务轮询 ───
const taskPollTimer = ref<ReturnType<typeof setInterval> | null>(null)
const POLL_INTERVAL = 5000

function startTaskPolling() {
  if (taskPollTimer.value) return
  taskPollTimer.value = setInterval(async () => {
    const hasActive = myTasks.value.some(
      t => t.status === 'pending' || t.status === 'running'
    )
    if (!hasActive) { stopTaskPolling(); return }
    await loadMyTasks()
  }, POLL_INTERVAL)
}

function stopTaskPolling() {
  if (taskPollTimer.value) {
    clearInterval(taskPollTimer.value)
    taskPollTimer.value = null
  }
}
// ─── Tab ───
const activeTab = ref<'questions' | 'tasks'>('questions')

function switchTab(tab: 'questions' | 'tasks') {
  activeTab.value = tab
  if (tab === 'tasks') { loadMyTasks(); startTaskPolling() }
}

// ─── 题库列表 ───
const questions = ref<QuestionItem[]>([])
const categories = ref<CategoryStat[]>([])
const loading = ref(false)
const filterCategory = ref('')
const filterDifficulty = ref('')
const keyword = ref('')
const page = ref(1)
const pageSize = 20
const total = ref(0)
const totalPages = computed(() => Math.ceil(total.value / pageSize) || 1)

async function loadQuestions(p = 1) {
  page.value = p
  loading.value = true
  try {
    const res = await getQuestions({
      category: filterCategory.value || undefined,
      keyword: keyword.value || undefined,
      difficulty: filterDifficulty.value || undefined,
      page: p,
      page_size: pageSize,
    })
    questions.value = res.data.items
    total.value = res.data.total
  } catch (e: any) {
    showToast('加载题目失败: ' + (e.message || ''), 'error')
  } finally {
    loading.value = false
  }
}

async function loadCategories() {
  try {
    const res = await getCategories()
    categories.value = res.data
  } catch (e) {
    console.error('load categories failed', e)
  }
}

// ─── 批量选择 ───
const selectedIds = ref<Set<number>>(new Set())

const isAllSelected = computed(() =>
  questions.value.length > 0 && questions.value.every(q => selectedIds.value.has(q.question_id))
)
const isPartialSelected = computed(() =>
  selectedIds.value.size > 0 && !isAllSelected.value
)

function toggleSelect(qid: number) {
  const s = new Set(selectedIds.value)
  if (s.has(qid)) s.delete(qid)
  else s.add(qid)
  selectedIds.value = s
}

function toggleSelectAll() {
  if (isAllSelected.value) {
    selectedIds.value = new Set()
  } else {
    selectedIds.value = new Set(questions.value.map(q => q.question_id))
  }
}

// 翻页时清空选择
watch(page, () => { selectedIds.value = new Set() })

// ─── 题目详情弹窗 ───
const detailData = ref<QuestionDetail | null>(null)
const detailSourceQuestion = ref<QuestionItem | null>(null)

async function openDetailDialog(q: QuestionItem) {
  detailSourceQuestion.value = q
  try {
    const res = await getQuestionDetail(q.question_id)
    detailData.value = res.data
  } catch (e: any) {
    // fallback: 用列表数据
    detailData.value = {
      ...q,
      task_history: [],
    } as QuestionDetail
  }
}

function openGenerateDialogFromDetail() {
  if (detailSourceQuestion.value) {
    openGenerateDialog(detailSourceQuestion.value)
  }
}

// ─── 单个生成弹窗 ───
const showGenDialog = ref(false)
const genTarget = ref<QuestionItem | null>(null)
const genPrompt = ref('')
const genMode = ref<'direct' | 'pipeline'>('pipeline')
const genPipelineId = ref('builtin_default_mode')
const generating = ref(false)

function openGenerateDialog(q: QuestionItem) {
  genTarget.value = q
  genPrompt.value = ''
  genMode.value = 'pipeline'
  genPipelineId.value = pipelines.value.length > 0 ? pipelines.value[0].id : ''
  showGenDialog.value = true
}

async function submitSingleGenerate() {
  if (!genTarget.value) return
  generating.value = true
  try {
    const pid = genMode.value === 'pipeline' ? genPipelineId.value : undefined
    const res = await generateQuestionDoc(genTarget.value.question_id, genPrompt.value, pid)
    showGenDialog.value = false
    const taskId = res.data?.task_id
    if (taskId) {
      // 弹窗由 activeTask computed 自动驱动，无需手动 startGenTracking
      showToast('🚀 生成任务已提交，请稍候...', 'success')
    } else {
      showToast('✅ 生成任务已提交！', 'success')
      switchTab('tasks')
      loadMyTasks()
      startTaskPolling()
    }
  } catch (e: any) {
    showToast('提交失败: ' + (e.message || ''), 'error')
  } finally {
    generating.value = false
  }
}

// ─── 批量生成弹窗 ───
const showBatchDialog = ref(false)
const batchPrompt = ref('')
const batchMode = ref<'direct' | 'pipeline'>('pipeline')
const batchPipelineId = ref('builtin_default_mode')
const batchGenerating = ref(false)

function openBatchGenerateDialog() {
  if (selectedIds.value.size === 0) return
  batchPrompt.value = ''
  batchMode.value = 'pipeline'
  batchPipelineId.value = pipelines.value.length > 0 ? pipelines.value[0].id : ''
  showBatchDialog.value = true
}

async function submitBatchGenerate() {
  if (selectedIds.value.size === 0) return
  batchGenerating.value = true
  try {
    const pid = batchMode.value === 'pipeline' ? batchPipelineId.value : undefined
    const res = await batchGenerateDocs([...selectedIds.value], batchPrompt.value, pid)
    showBatchDialog.value = false
    const d = res.data
    showToast(`✅ ${d.message}${d.errors.length > 0 ? `，${d.errors.length} 个失败` : ''}`, d.errors.length > 0 ? 'info' : 'success')
    switchTab('tasks')
    startTaskPolling()
    selectedIds.value = new Set()
    loadMyTasks()
  } catch (e: any) {
    showToast('批量提交失败: ' + (e.message || ''), 'error')
  } finally {
    batchGenerating.value = false
  }
}

// ─── 添加题目弹窗 ───
const showAddDialog = ref(false)
const addForm = ref({
  title: '',
  title_en: '',
  category: '',
  description: '',
  keywordsStr: '',
  difficulty: 'medium',
})
const addingQuestion = ref(false)

// ─── 导入 Science 125 ───
const importing125 = ref(false)

async function importScience125() {
  if (!confirm('将导入 Science 125 道经典科学问题到题库，已存在的题目会自动跳过。继续？')) return
  importing125.value = true
  try {
    const res = await batchImportQuestions(SCIENCE_125_DATA, true)
    const d = res.data
    showToast(`✅ ${d.message}`, 'success')
    loadQuestions(1)
    loadCategories()
  } catch (e: any) {
    showToast('导入失败: ' + (e.message || ''), 'error')
  } finally {
    importing125.value = false
  }
}

const handleBatchDelete = async () => {
  if (!confirm(`确定删除选中的 ${selectedIds.value.length} 道题目？`)) return
  try {
    const res = await batchDeleteQuestions([...selectedIds.value])
    alert(res.data?.message || '删除成功')
    selectedIds.value = new Set()
    await loadQuestions()
  } catch (e: any) {
    alert('删除失败: ' + (e?.message || e?.response?.data?.detail || e))
  }
}

const handleDeleteAll = async () => {
  if (!confirm('⚠️ 确定清空全部题目？此操作不可恢复！')) return
  if (!confirm('再次确认：真的要删除所有题目吗？')) return
  try {
    const res = await deleteAllQuestions()
    alert(res.data?.message || '已清空')
    selectedIds.value = new Set()
    await loadQuestions()
  } catch (e: any) {
    alert('操作失败: ' + (e?.message || e?.response?.data?.detail || e))
  }
}


async function submitAddQuestion() {
  if (!addForm.value.title.trim() || !addForm.value.category.trim()) return
  addingQuestion.value = true
  try {
    const kws = addForm.value.keywordsStr
      .split(/[,，]/)
      .map(s => s.trim())
      .filter(Boolean)
    await createQuestion({
      title: addForm.value.title.trim(),
      title_en: addForm.value.title_en.trim() || undefined,
      category: addForm.value.category.trim(),
      description: addForm.value.description.trim(),
      keywords: kws,
      difficulty: addForm.value.difficulty,
    })
    showAddDialog.value = false
    addForm.value = { title: '', title_en: '', category: '', description: '', keywordsStr: '', difficulty: 'medium' }
    showToast('✅ 题目添加成功！', 'success')
    loadQuestions(page.value)
    loadCategories()
  } catch (e: any) {
    showToast('添加失败: ' + (e.message || ''), 'error')
  } finally {
    addingQuestion.value = false
  }
}

// ─── 流水线列表 ───
const pipelines = ref<Array<{id: string; name: string; isTemplate?: boolean}>>([])

// 内置默认流水线（确保永远有选项）
const BUILTIN_PIPELINES = [
  { id: 'agent_center_current', name: '🤖 Agent中心当前编排（动态）', isTemplate: false },
  { id: 'builtin_default_mode', name: '🏆 默认模式（赛题对齐·9步全流程）', isTemplate: true },
  { id: 'builtin_full_closure', name: '🔬 全流程科研闭环（9步）', isTemplate: true },
  { id: 'builtin_quick_analysis', name: '⚡ 快速分析（3步）', isTemplate: true },
  { id: 'builtin_literature_hypothesis', name: '📚 文献+假设（4步）', isTemplate: true },
]

async function loadPipelines() {
  const builtinList = [...BUILTIN_PIPELINES]
  let customPipelines: any[] = []
  let templatePipelines: any[] = []
  try {
    const [listRes, tplRes] = await Promise.allSettled([
      automationApi.list(),
      automationApi.templates(),
    ])
    if (listRes.status === 'fulfilled') {
      customPipelines = (listRes.value.data.pipelines || []).map((p: any) => ({
        id: p.id,
        name: p.name,
        isTemplate: false,
      }))
    }
    if (tplRes.status === 'fulfilled') {
      templatePipelines = (tplRes.value.data.templates || []).map((t: any) => ({
        id: t.id,
        name: `📋 ${t.name}`,
        isTemplate: true,
      }))
    }
  } catch (e) {
    console.error('load pipelines failed, using builtin only', e)
  }
  pipelines.value = [...builtinList, ...templatePipelines, ...customPipelines]
}

// ─── 我的任务 ───
const myTasks = ref<MyTaskItem[]>([])

// ─── 弹窗绑定的活动任务（取列表中第一个 running 任务）───
const activeTask = computed(() => {
  return myTasks.value.find(t => t.status === 'running' || t.status === 'pending') || null
})

// ─── 拖拽相关 ───
// 初始位置：右下角（与原来 fixed bottom-6 right-6 一致）
const genDialogPos = ref({
  x: typeof window !== 'undefined' ? Math.max(0, window.innerWidth - 380) : 800,
  y: typeof window !== 'undefined' ? Math.max(0, window.innerHeight - 340) : 400
})
const isDragging = ref(false)
let dragStartPos = { x: 0, y: 0, ox: 0, oy: 0 }

function onDragStart(e: MouseEvent) {
  isDragging.value = true
  dragStartPos = { x: e.clientX, y: e.clientY, ox: genDialogPos.value.x, oy: genDialogPos.value.y }
  document.addEventListener('mousemove', onDragMove)
  document.addEventListener('mouseup', onDragEnd)
}

function onDragMove(e: MouseEvent) {
  if (!isDragging.value) return
  genDialogPos.value = {
    x: dragStartPos.ox + (e.clientX - dragStartPos.x),
    y: dragStartPos.oy + (e.clientY - dragStartPos.y),
  }
}

function onDragEnd() {
  isDragging.value = false
  document.removeEventListener('mousemove', onDragMove)
  document.removeEventListener('mouseup', onDragEnd)
}

const tasksLoading = ref(false)
const taskStatusFilter = ref('')

let _taskPollTimer: ReturnType<typeof setInterval> | null = null

async function loadMyTasks() {
  tasksLoading.value = true
  try {
    const res = await getMyTasks({
      page: 1,
      page_size: 50,
      status: taskStatusFilter.value || undefined,
    })
    myTasks.value = res.data.items
    // 如果有 running 任务，启动自动轮询
    const hasRunning = myTasks.value.some((t: any) => t.status === 'running')
    if (hasRunning && !_taskPollTimer) {
      _taskPollTimer = setInterval(async () => {
        try {
          const r = await getMyTasks({ page: 1, page_size: 50, status: taskStatusFilter.value || undefined })
          myTasks.value = r.data.items
          if (!myTasks.value.some((t: any) => t.status === 'running')) {
            if (_taskPollTimer) { clearInterval(_taskPollTimer); _taskPollTimer = null }
          }
        } catch {}
      }, 3000)
    } else if (!hasRunning && _taskPollTimer) {
      clearInterval(_taskPollTimer); _taskPollTimer = null
    }
  } catch (e: any) {
    console.error('load tasks failed', e)
  } finally {
    tasksLoading.value = false
  }
}

watch(() => activeTab.value, (tab) => {
  if (tab === 'tasks') loadMyTasks()
})

// ─── 任务批量选择 ───
const selectedTaskIds = ref<Set<number>>(new Set())

const isAllTasksSelected = computed(() =>
  myTasks.value.length > 0 && myTasks.value.every(t => selectedTaskIds.value.has(t.task_id))
)
const isPartialTasksSelected = computed(() =>
  selectedTaskIds.value.size > 0 && !isAllTasksSelected.value
)

function toggleSelectTask(tid: number) {
  const s = new Set(selectedTaskIds.value)
  if (s.has(tid)) s.delete(tid)
  else s.add(tid)
  selectedTaskIds.value = s
}

function toggleSelectAllTasks() {
  if (isAllTasksSelected.value) {
    selectedTaskIds.value = new Set()
  } else {
    selectedTaskIds.value = new Set(myTasks.value.map(t => t.task_id))
  }
}

// ─── 删除任务 ───
async function confirmDeleteTask(taskId: number) {
  if (!confirm('确定要删除任务 #' + taskId + ' 吗？此操作不可撤销。')) return
  try {
    await deleteTask(taskId)
    await deleteTask(taskId)
    showToast('✅ 任务已删除', 'success')
    selectedTaskIds.value = new Set([...selectedTaskIds.value].filter(id => id !== taskId))
    await loadMyTasks()
    try { projectStore.fetchProjects({ workspace: appStore.currentWorkspace }) } catch (e) {}
    selectedTaskIds.value = new Set([...selectedTaskIds.value].filter(id => id !== taskId))
    await loadMyTasks()
  } catch (e: any) {
    showToast('删除失败: ' + (e?.message || ''), 'error')
  }
}

async function confirmBatchDeleteTasks() {
  const count = selectedTaskIds.value.size
  if (count === 0) return
  if (!confirm('确定要批量删除 ' + count + ' 个任务吗？此操作不可撤销。')) return
  try {
    const res = await batchDeleteTasks([...selectedTaskIds.value])
    const d = res.data
    showToast(
      (d?.message || '操作完成') + (d && d.errors && d.errors.length > 0 ? '，' + d.errors.length + ' 个失败' : ''),
      (d && d.errors && d.errors.length > 0) ? 'info' : 'success'
    )
    selectedTaskIds.value = new Set()
    await loadMyTasks()
    try { projectStore.fetchProjects({ workspace: appStore.currentWorkspace }) } catch (e) {}
    selectedTaskIds.value = new Set()
    await loadMyTasks()
  } catch (e: any) {
    showToast('批量删除失败: ' + (e?.message || ''), 'error')
  }
}

// ─── 重试任务 ───
const retryingTaskId = ref<number | null>(null)

async function handleRetryTask(taskId: number) {
  if (!confirm('确定要重试此任务吗？将基于原配置创建新版本任务。')) return
  retryingTaskId.value = taskId
  try {
    const res = await retryTask(taskId)
    const d = res.data
      showToast(`✅ ${d.message}`, 'success')
    const task = myTasks.value.find(t => t.task_id === taskId)
    if (task) {
      appStore.startGenTracking(d.task_id, task.question_title || '')
    }
    await loadMyTasks()
    startTaskPolling()
    taskDetail.value = null
  } catch (e: any) {
    showToast('重试失败: ' + (e.message || ''), 'error')
  } finally {
    retryingTaskId.value = null
  }
}



// ─── 任务详情弹窗 ───
const taskDetail = ref<TaskStatus | null>(null)
const feedbackText = ref('')
const submittingFeedback = ref(false)

async function viewTaskDetail(taskId: number) {
  try {
    const res = await getTaskStatus(taskId)
    taskDetail.value = res.data
    feedbackText.value = ''
  } catch (e: any) {
    showToast('加载任务详情失败', 'error')
  }
}

async function submitTaskFeedback() {
  if (!taskDetail.value || !feedbackText.value.trim()) return
  submittingFeedback.value = true
  try {
    await submitFeedback(taskDetail.value.task_id, feedbackText.value)
    feedbackText.value = ''
    showToast('✅ 反馈已提交', 'success')
    await viewTaskDetail(taskDetail.value.task_id)
  } catch (e: any) {
    showToast('提交反馈失败', 'error')
  } finally {
    submittingFeedback.value = false
  }
}

// ─── 跳转到工作台项目 ───
import { useRouter } from 'vue-router'
import { useAppStore } from '@/stores/app'
const router = useRouter()
function goToProject(projectId: number) {
  // 用路由 name 跳转, 兼容任意嵌套父路径
  router.push({ name: 'ProjectDetail', params: { id: String(projectId) } })
}

// ─── 文档预览 ───
const docContent = ref<DocumentContent | null>(null)

async function viewDocument(taskId: number) {
  try {
    const res = await getTaskDocument(taskId)
    docContent.value = res.data
  } catch (e: any) {
    showToast('文档尚未生成或无法读取', 'error')
  }
}

// ─── 工具函数 ───
function difficultyClass(d: string) {
  const map: Record<string, string> = {
    easy: 'bg-green-100 text-green-700',
    medium: 'bg-yellow-100 text-yellow-700',
    hard: 'bg-red-100 text-red-700',
  }
  return map[d] || 'bg-surface-100 text-surface-600'
}

function difficultyLabel(d: string) {
  const map: Record<string, string> = { easy: '简单', medium: '中等', hard: '困难' }
  return map[d] || d
}

function statusClass(s: string) {
  const map: Record<string, string> = {
    pending: 'bg-yellow-100 text-yellow-700',
    running: 'bg-blue-100 text-blue-700',
    completed: 'bg-green-100 text-green-700',
    failed: 'bg-red-100 text-red-700',
  }
  return map[s] || 'bg-surface-100 text-surface-600'
}

function statusLabel(s: string) {
  const map: Record<string, string> = {
    pending: '等待中', running: '运行中', completed: '已完成', failed: '失败',
  }
  return map[s] || s
}

function formatDate(iso?: string | null) {
  if (!iso) return '-'
  return new Date(iso).toLocaleString('zh-CN')
}

// ─── 初始化 ───
onMounted(() => {
  loadCategories()
  loadQuestions()
  loadMyTasks()
  loadPipelines()
})

onUnmounted(() => {
  stopTaskPolling()
})
</script>

