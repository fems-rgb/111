    <!-- ═══════════════════════════════════════════════════════ -->
    <Teleport to="body">
      <div v-if="taskDetail" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40" @click.self="taskDetail = null">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl p-6 space-y-4 max-h-[85vh] overflow-y-auto">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-surface-800">📄 任务详情 #{{ taskDetail.task_id }}</h2>
            <button @click="taskDetail = null" class="text-surface-400 hover:text-surface-600 text-xl">✕</button>
          </div>
          <p v-if="taskDetail.question_title" class="text-sm text-surface-600">
            题目：<strong>{{ taskDetail.question_title }}</strong>
          </p>
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div><span class="text-surface-400">状态：</span>
              <span :class="statusClass(taskDetail.status)" class="px-2 py-0.5 rounded-full text-xs font-medium">{{ statusLabel(taskDetail.status) }}</span>
            </div>
            <div><span class="text-surface-400">版本：</span>v{{ taskDetail.version }}</div>
            <div><span class="text-surface-400">创建：</span>{{ formatDate(taskDetail.created_at) }}</div>
            <div><span class="text-surface-400">完成：</span>{{ formatDate(taskDetail.completed_at) }}</div>
          </div>
          <div v-if="taskDetail.result?.generation_mode" class="text-xs text-surface-400">
            生成方式：{{ taskDetail.result.generation_mode }}
            <span v-if="taskDetail.result.pipeline_id"> · 流水线 {{ taskDetail.result.pipeline_id }}</span>
          </div>
          <div v-if="taskDetail.document_path" class="p-3 bg-green-50 rounded-lg text-sm text-green-700 flex items-center justify-between">
            <span>📁 {{ taskDetail.document_path }}</span>
            <button @click="viewDocument(taskDetail.task_id)" class="text-green-600 hover:underline text-xs font-medium">查看内容 →</button>
          </div>
          <div v-if="taskDetail.error_message" class="p-3 bg-red-50 rounded-lg text-sm text-red-700">
            ❌ {{ taskDetail.error_message }}
          </div>
          <div v-if="taskDetail.status === 'failed'" class="flex items-center gap-3 pt-2">
            <button @click="handleRetryTask(taskDetail.task_id)"
                    :disabled="retryingTaskId === taskDetail.task_id"
                    class="px-4 py-2 rounded-lg text-sm bg-amber-500 text-white hover:bg-amber-600 disabled:opacity-50 transition-colors font-medium">
              {{ retryingTaskId === taskDetail.task_id ? '⏳ 重试中...' : '🔄 重试此任务' }}
            </button>
            <span class="text-xs text-surface-400">将基于原配置创建新版本</span>
          </div>
          <div v-if="taskDetail.result && Object.keys(taskDetail.result).length > 0" class="space-y-2">
            <p class="text-sm font-medium text-surface-600">生成元数据：</p>
            <pre class="p-3 bg-surface-50 rounded-lg text-xs overflow-x-auto whitespace-pre-wrap">{{ JSON.stringify(taskDetail.result, null, 2) }}</pre>
          </div>

          <!-- 反馈区 -->
          <div class="space-y-2 pt-2 border-t border-surface-100">
            <p class="text-sm font-medium text-surface-600">💬 提交反馈 / 迭代优化</p>
            <textarea v-model="feedbackText" rows="3" placeholder="输入您的反馈意见..."
                      class="w-full border border-surface-200 rounded-lg px-3 py-2 text-sm resize-none focus:ring-2 focus:ring-primary-300 outline-none"></textarea>
            <button @click="submitTaskFeedback" :disabled="!feedbackText.trim() || submittingFeedback"
                    class="px-4 py-2 rounded-lg text-sm bg-primary-600 text-white hover:bg-primary-700 disabled:opacity-50 transition-colors">
              {{ submittingFeedback ? '提交中...' : '提交反馈' }}
            </button>
          </div>
