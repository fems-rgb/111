}
.toast-enter-from, .toast-leave-to {
  opacity: 0;
  transform: translateY(-12px);
}
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>

